---
import Heading from '../ui/Heading.astro';
import MedievalDivider from '../ui/MedievalDivider.astro';
import Paragraph from '../ui/Paragraph.astro';

const stats = [
  {
    value: '2,000+',
    label: 'Posts & Items Automated',
    subtext: 'Seamless content distribution'
  },
  {
    value: '99.9%',
    label: 'Uptime & Reliability',
    subtext: 'Hardened web architecture'
  },
  {
    value: '50+',
    label: 'Workflows Deployed',
    subtext: 'Custom business automation'
  }
];
---

<section class="w-full py-8 px-4">
  <MedievalDivider variant="diamond" className="mt-4" />
  <div class="max-w-5xl mx-auto">
    <div
      class="grid grid-cols-1 md:grid-cols-3 gap-8 py-6 px-4 bg-transparent text-center"
    >
      {
        stats.map((stat) => (
          <div class="flex flex-col items-center justify-center p-4">
            <span class="font-heading font-bold text-4xl sm:text-5xl text-bronze mb-1">
              {stat.value}
            </span>
            <Heading as="span" size="sub" align="center" className="uppercase tracking-wider mb-1">
              {stat.label}
            </Heading>
            <Paragraph variant="caption" align="center" className="text-sm">
              {stat.subtext}
            </Paragraph>
          </div>
        ))
      }
    </div>
  </div>
  <MedievalDivider variant="diamond" className="mt-4" />
</section>
