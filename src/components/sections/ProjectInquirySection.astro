---
import { allSocialLinks } from '../../data/socials';
import MedievalFrame from '../common/MedievalFrame.astro';
import SectionHeader from '../common/SectionHeader.astro';
import PrimaryButton from '../ui/PrimaryButton.astro';
import SocialLink from '../ui/SocialLink.astro';

interface Props {
  id?: string;
  formId?: string;
}

const { id = 'contact', formId = 'project-inquiry-form' } = Astro.props;
const nameInputId = `${formId}-name`;
const emailInputId = `${formId}-email`;
const subjectInputId = `${formId}-subject`;
const messageInputId = `${formId}-message`;
---

<section id={id} data-upwork-hide="true" class="w-full py-12 md:py-16 px-4 sm:px-6">
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Left Column: Copy, Direct Action & Proof Status -->
      <div class="lg:col-span-5 flex flex-col justify-between pt-2">
        <div>
          <SectionHeader
            size="small"
            as="h2"
            headingSize="section"
            paragraphVariant="lead"
            subtitle="Initiate Architecture"
            title="Start Your Project"
            description="Join the ranks of businesses that trust engineered precision. Initiate a discovery discussion or describe your technical parameters to bring your automation vision to life."
          />

          <!-- Social Direct Connect (All 8 Platforms) -->
          <div class="flex flex-wrap items-center gap-2 mb-5">
            {
              allSocialLinks.map((item) => (
                <SocialLink platform={item.platform} href={item.href} />
              ))
            }
          </div>

          <div class="mb-8">
            <PrimaryButton href="/book-a-call" size="md">
              Book a Free Call &rarr;
            </PrimaryButton>
          </div>
        </div>
      </div>

      <!-- Right Column: Medieval Framed Intake Form -->
      <div class="lg:col-span-7">
        <MedievalFrame size="small">
          <form class="project-inquiry-form space-y-5" data-project-inquiry-form>
            <!-- Spam Honeypot Trap (Hidden from real users) -->
            <input
              type="text"
              name="_gotcha"
              class="hidden"
              tabindex="-1"
              autocomplete="off"
            />

            <!-- Name & Email 2-Column Row -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label
                  for={nameInputId}
                  class="block font-heading font-semibold text-sm text-ink mb-1.5"
                >
                  Name / Company <span class="text-bronze">*</span>
                </label>
                <input
                  type="text"
                  id={nameInputId}
                  name="name"
                  required
                  placeholder="Enter full name"
                  class="w-full bg-parchment border border-ink/40 px-4 py-3 text-ink font-body text-sm placeholder:text-ink/40 focus:border-bronze focus:outline-none focus:ring-1 focus:ring-bronze transition-all"
                />
              </div>

              <div>
                <label
                  for={emailInputId}
                  class="block font-heading font-semibold text-sm text-ink mb-1.5"
                >
                  Email Address <span class="text-bronze">*</span>
                </label>
                <input
                  type="email"
                  id={emailInputId}
                  name="email"
                  required
                  placeholder="name@domain.com"
                  class="w-full bg-parchment border border-ink/40 px-4 py-3 text-ink font-body text-sm placeholder:text-ink/40 focus:border-bronze focus:outline-none focus:ring-1 focus:ring-bronze transition-all"
                />
              </div>
            </div>

            <!-- Subject / Project Type Select -->
            <div>
              <label
                for={subjectInputId}
                class="block font-heading font-semibold text-sm text-ink mb-1.5"
              >
                Inquiry Type <span class="text-bronze">*</span>
              </label>
              <select
                id={subjectInputId}
                name="subject"
                required
                class="form-subject w-full bg-parchment border border-ink/40 px-4 py-3 text-ink font-body text-sm focus:border-bronze focus:outline-none focus:ring-1 focus:ring-bronze transition-all cursor-pointer"
              >
                <option value="Workflow Automation (n8n / Make / Zapier)">
                  Workflow Automation (n8n / Make / Zapier)
                </option>
                <option value="Messaging & Social Bots (Telegram / Discord / WhatsApp)">
                  Messaging &amp; Social Bots (Telegram / Discord / WhatsApp)
                </option>
                <option value="AI Systems & Custom Web Apps (Astro / Next.js / E-Commerce)">
                  AI Systems &amp; Custom Web Apps (Astro / Next.js / E-Commerce)
                </option>
                <option value="Infrastructure & Custom Cloud Architecture">
                  Infrastructure &amp; Custom Cloud Architecture
                </option>
                <option value="General Architecture Consultation">
                  General Architecture Consultation
                </option>
              </select>
            </div>

            <!-- Message Textarea -->
            <div>
              <label
                for={messageInputId}
                class="block font-heading font-semibold text-sm text-ink mb-1.5"
              >
                Project Parameters &amp; Goals <span class="text-bronze">*</span>
              </label>
              <textarea
                id={messageInputId}
                name="message"
                required
                rows="4"
                placeholder="Describe the bottlenecks you want to resolve or system specifications..."
                class="w-full bg-parchment border border-ink/40 px-4 py-3 text-ink font-body text-sm placeholder:text-ink/40 focus:border-bronze focus:outline-none focus:ring-1 focus:ring-bronze transition-all resize-none"
              ></textarea>
            </div>

            <!-- Submit Button -->
            <div class="pt-2">
              <PrimaryButton type="submit" fullWidth>
                Submit Project Inquiry &rarr;
              </PrimaryButton>
            </div>

            <!-- Status Feedback Container -->
            <div
              class="form-status hidden p-4 border font-body text-sm text-center"
            >
            </div>
          </form>
        </MedievalFrame>
      </div>
    </div>
  </div>
</section>

<script>
  function applySubjectFromUrl(subjectSelect: HTMLSelectElement) {
    try {
      let subjectParam: string | null = null;
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.has('subject')) {
        subjectParam = urlParams.get('subject');
      } else if (window.location.hash.includes('?subject=')) {
        const hashQuery = window.location.hash.split('?subject=')[1];
        if (hashQuery) {
          subjectParam = decodeURIComponent(hashQuery);
        }
      }

      if (subjectParam) {
        const matchingOption = Array.from(subjectSelect.options).find(
          (opt) => opt.value.toLowerCase() === subjectParam?.toLowerCase() ||
                   opt.value.toLowerCase().includes(subjectParam?.toLowerCase() || '')
        );
        if (matchingOption) {
          subjectSelect.value = matchingOption.value;
        }
      }
    } catch {
      // Graceful fallback if URL parsing fails
    }
  }

  function setupProjectInquiryForms() {
    const forms = document.querySelectorAll<HTMLFormElement>('form[data-project-inquiry-form]');
    forms.forEach((form) => {
      const statusBox = form.querySelector('.form-status');
      const subjectSelect = form.querySelector<HTMLSelectElement>('.form-subject');
      if (!statusBox) return;

      if (subjectSelect) {
        applySubjectFromUrl(subjectSelect);
        window.addEventListener('hashchange', () => applySubjectFromUrl(subjectSelect));
      }

      form.addEventListener('submit', (e) => {
        e.preventDefault();

        // Check honeypot
        const honeypot = form.querySelector<HTMLInputElement>('input[name="_gotcha"]');
        if (honeypot && honeypot.value !== '') {
          // Silently drop bot submission
          return;
        }

        const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerText = 'Dispatching Parameters...';
        }

        // Simulate instantaneous client-side acknowledgment (ready for API wire-up)
        setTimeout(() => {
          statusBox.classList.remove('hidden', 'border-crimson', 'text-crimson', 'bg-crimson/10');
          statusBox.classList.add('border-bronze', 'text-ink', 'bg-parchmentDark');
          statusBox.innerHTML =
            '<strong>Inquiry Registered:</strong> Your project parameters have been received. We will review your architecture and respond within 24 hours.';

          form.reset();
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerText = 'Submit Project Inquiry →';
          }
        }, 600);
      });
    });
  }

  setupProjectInquiryForms();
  document.addEventListener('astro:after-swap', setupProjectInquiryForms);
</script>
