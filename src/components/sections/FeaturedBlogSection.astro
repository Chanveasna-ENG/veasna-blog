---
import { getCollection } from 'astro:content';
import { getLatestPosts } from '../../utils/blog';
import { formatDateICT } from '../../utils/date';
import MedievalFrame from '../common/MedievalFrame.astro';
import SectionHeader from '../common/SectionHeader.astro';
import Heading from '../ui/Heading.astro';
import Paragraph from '../ui/Paragraph.astro';
import SecondaryButton from '../ui/SecondaryButton.astro';
import SubtitleTag from '../ui/SubtitleTag.astro';

const allBlogPosts = await getCollection('blog');
const featuredPosts = getLatestPosts(allBlogPosts, 3);
---

<section id="blogs" class="w-full py-12 md:py-16 px-4 sm:px-6">
  <div class="max-w-6xl mx-auto">
    <!-- Section Header -->
    <SectionHeader
      subtitle="Knowledge & Field Notes"
      title="Technical Blueprints & Automation Hacks"
      description="Step-by-step technical guides, automation patterns, and engineering insights from active production systems."
    />

    <!-- 3-Column Blog Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {featuredPosts.map((post) => {
        const postDate = post.data.lastModifiedAt || post.data.createdAt;
        return (
          <MedievalFrame size="small" as="article" interactive={true}>
            <div>
              <!-- Category and Date Meta -->
              <div class="flex items-center justify-between gap-2 mb-4">
                <SubtitleTag variant="badge" size="sm" color="bronze" spacing="none">
                  {post.data.category || 'Guide'}
                </SubtitleTag>
                <time datetime={postDate.toISOString()} class="text-xs font-body text-inkMuted">
                  {formatDateICT(postDate).split(',')[0]}
                </time>
              </div>

              <!-- Article Title -->
              <a href={`/posts/${post.id}`} class="block group-hover:text-bronze transition-colors">
                <Heading as="h3" size="card" spacing="sm" clamp={2}>
                  {post.data.title}
                </Heading>
              </a>

              <!-- Description -->
              <Paragraph variant="small" clamp={3}>
                {post.data.description}
              </Paragraph>
            </div>

            <!-- Footer Link -->
            <div class="pt-4 border-t border-ink/10 flex items-center justify-between">
              <a
                href={`/posts/${post.id}`}
                class="font-heading font-semibold text-xs text-ink group-hover:text-bronze flex items-center gap-1.5 transition-colors uppercase tracking-wider"
              >
                Read Blueprint <span>&rarr;</span>
              </a>
              {post.data.tags && post.data.tags.length > 0 && (
                <span class="text-[10px] font-body text-inkMuted bg-parchmentDark px-2 py-0.5 border border-ink/10">
                  #{post.data.tags[0]}
                </span>
              )}
            </div>
          </MedievalFrame>
        );
      })}
    </div>

    <!-- Explore All Blogs Button -->
    <div class="mt-12 text-center">
      <SecondaryButton href="/page/1" className="px-8 py-3 text-sm">
        Explore All Articles &amp; Technical Docs &rarr;
      </SecondaryButton>
    </div>

  </div>
</section>
