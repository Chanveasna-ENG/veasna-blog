---
import {
  formatStartingPrice,
  getInquiryUrl,
  getPricingTiers
} from '../../utils/pricing';
import Checklist from '../common/Checklist.astro';
import MedievalFrame from '../common/MedievalFrame.astro';
import SectionHeader from '../common/SectionHeader.astro';
import Heading from '../ui/Heading.astro';
import Paragraph from '../ui/Paragraph.astro';
import PrimaryButton from '../ui/PrimaryButton.astro';

const tiers = getPricingTiers();
---

<section id="pricing" class="w-full py-12 md:py-16 px-4 sm:px-6">
  <div class="max-w-6xl mx-auto">
    <!-- Section Header -->
    <SectionHeader
      subtitle="Pricing"
      title="Clear Starting Rates"
      description="Every project has different requirements, but here are baseline estimates so you know what to expect before we talk."
    />

    <!-- Pricing Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch">
      {tiers.map((tier) => (
        <MedievalFrame size="medium" interactive={true}>
          <div>
            <!-- Tier Header -->
            <div class="mb-4">
              <Heading as="h3" size="card" spacing="xs">
                {tier.title}
              </Heading>
              <Paragraph variant="small" spacing="none">
                {tier.subtitle}
              </Paragraph>
            </div>

            <!-- Price Display -->
            <div class="py-4 my-2 border-y border-ink/15">
              <div class="flex items-baseline gap-2">
                <span class="text-xs uppercase font-heading font-semibold text-inkMuted tracking-wider">Starting from</span>
                <span class="font-heading font-bold text-3xl sm:text-4xl text-ink">
                  {formatStartingPrice(tier.startingPrice, tier.currency)}
                </span>
              </div>
              <div class="mt-1 flex items-center gap-2 text-xs font-body text-bronze font-semibold">
                <span>⏱ Typical delivery: {tier.turnaround}</span>
              </div>
            </div>

            <!-- Deliverables Checklist -->
            <div class="mt-4 mb-6">
              <span class="block font-heading font-semibold text-xs uppercase tracking-wider text-ink mb-3">
                Scope Includes:
              </span>
              <Checklist items={tier.deliverables} bullet="diamond" spacing="md" />
            </div>
          </div>

          <!-- Card Action & Recommendation Footer -->
          <div class="pt-4 border-t border-ink/10 mt-4">
            <Paragraph variant="caption" spacing="sm">
              Ideal for: {tier.recommendedFor}
            </Paragraph>

            <PrimaryButton
              href={getInquiryUrl(tier.ctaSubject)}
              size="sm"
              fullWidth
            >
              Scope This Build &rarr;
            </PrimaryButton>
          </div>
        </MedievalFrame>
      ))}
    </div>
  </div>
</section>
