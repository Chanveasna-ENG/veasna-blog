---
import MedievalFrame from '../common/MedievalFrame.astro';
import SectionHeader from '../common/SectionHeader.astro';
import Heading from '../ui/Heading.astro';
import Paragraph from '../ui/Paragraph.astro';

const expectations = [
  {
    step: '01',
    title: 'Personalized Strategy',
    description:
      'We review your existing tool stack and repetitive manual workflows to pinpoint where automation will save the most time and money.'
  },
  {
    step: '02',
    title: 'Architectural Feasibility',
    description:
      'We outline the exact setup required—whether webhook pipelines (n8n, Make), messaging bots (Telegram, Discord), or full custom web apps.'
  },
  {
    step: '03',
    title: 'Clear Next Steps',
    description:
      'You get direct technical recommendations, realistic milestones, and fixed pricing baselines with zero aggressive sales pressure.'
  }
];
---

<section id="expectations" class="w-full py-12 md:py-16 px-4 sm:px-6">
  <div class="max-w-6xl mx-auto">
    <SectionHeader
      size="normal"
      as="h2"
      headingSize="section"
      paragraphVariant="lead"
      subtitle="Consultation Roadmap"
      title="What To Expect On The Call"
      description="A direct 15-minute working session with an engineer to evaluate your technical parameters and operational roadmap."
      divider="feather"
    />

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8 sm:mt-12">
      {
        expectations.map((item) => (
          <MedievalFrame size="small" interactive={true}>
            <div class="p-6 flex flex-col items-start text-left h-full">
              <span class="font-heading font-bold text-xs uppercase tracking-widest text-bronze border border-bronze px-2.5 py-0.5 mb-4">
                Step {item.step}
              </span>
              <Heading as="h3" size="card" spacing="sm">
                {item.title}
              </Heading>
              <Paragraph variant="body" spacing="none">
                {item.description}
              </Paragraph>
            </div>
          </MedievalFrame>
        ))
      }
    </div>
  </div>
</section>
