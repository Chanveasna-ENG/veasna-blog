---
import Heading from '../ui/Heading.astro';
import MedievalCorner from '../ui/MedievalCorner.astro';
import MedievalDivider from '../ui/MedievalDivider.astro';
import Paragraph from '../ui/Paragraph.astro';
import SecondaryButton from '../ui/SecondaryButton.astro';
import SocialLink from '../ui/SocialLink.astro';
import SubtitleTag from '../ui/SubtitleTag.astro';

const medievalCornerSize = 69;

const socialLinks = [
  { platform: 'linkedin' as const, href: 'https://linkedin.com' },
  { platform: 'upwork' as const, href: 'https://upwork.com' },
  { platform: 'instagram' as const, href: 'https://instagram.com' },
  { platform: 'email' as const, href: 'mailto:contact@chanveasna.eng' }
];
---

<section id="architect" class="w-full py-12 md:py-16 px-4 sm:px-6">
  <div class="max-w-6xl mx-auto">
    <!-- Outer Medieval Frame -->
    <div class="medieval-frame p-8 sm:p-12 md:p-14 relative">
      <MedievalCorner
        position="top-left"
        size={medievalCornerSize}
        className="absolute top-1 left-1 text-ink"
      />
      <MedievalCorner
        position="top-right"
        size={medievalCornerSize}
        className="absolute top-1 right-1 text-ink"
      />
      <MedievalCorner
        position="bottom-left"
        size={medievalCornerSize}
        className="absolute bottom-1 left-1 text-ink"
      />
      <MedievalCorner
        position="bottom-right"
        size={medievalCornerSize}
        className="absolute bottom-1 right-1 text-ink"
      />

      <div
        class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center"
      >
        <!-- Left Column: Narrative, Philosophy & Social Channels (7 cols) -->
        <div class="lg:col-span-7 flex flex-col text-left">
          <!-- Subtitle Tag -->
          <SubtitleTag variant="bordered" size="sm" className="self-start mb-4">
            Digital Architect &amp; Workflow Specialist
          </SubtitleTag>

          <!-- Section Title -->
          <Heading as="h2" size="section" spacing="lg">
            Meet Veasna — Your Architect
          </Heading>

          <!-- Generic Subtext / Bio (Easily Editable) -->
          <div class="space-y-4">
            <Paragraph variant="body">
              I architect high-performance digital systems and custom automated
              engines designed to solve real business bottlenecks. By merging
              the deliberate precision of classical craftsmanship with modern
              engineering discipline, I eliminate repetitive toil and construct
              resilient web infrastructure.
            </Paragraph>
            <Paragraph variant="body">
              Whether engineering scalable lead portals or orchestrating complex
              multi-system workflow automations, every solution is built with
              longevity, security, and measurable commercial outcome at its
              core.
            </Paragraph>
          </div>

          <!-- Divider -->
          <MedievalDivider variant="feather" className="!justify-start" />

          <!-- Social Links & Direct Contact Channels -->
          <div class="flex flex-col sm:flex-row sm:items-center gap-4">
            <span
              class="font-heading font-semibold text-xs uppercase tracking-widest text-bronze"
            >
              Connect &amp; Follow:
            </span>
            <div class="flex items-center gap-2.5">
              {
                socialLinks.map((item) => (
                  <SocialLink platform={item.platform} href={item.href} />
                ))
              }
            </div>
          </div>
        </div>

        <!-- Right Column: Framed Headshot & Approachable Action (5 cols) -->
        <div class="lg:col-span-5 flex flex-col items-center">
          <!-- Portrait Frame Card -->
          <div
            class="w-full max-w-sm p-4 bg-parchment/40 border border-ink/30 relative flex flex-col items-center engraved-shadow"
          >
            <!-- Profile Image Container -->
            <div
              class="w-full aspect-[4/5] sm:aspect-square overflow-hidden border border-ink relative mb-4 group"
            >
              <img
                src="/images/profile.jpg"
                alt="Chanveasna ENG Headshot"
                class="w-full h-full object-cover contrast-105 transition-all duration-500"
                loading="lazy"
              />
              <div
                class="absolute inset-0 border-2 border-bronze/30 pointer-events-none"
              >
              </div>
            </div>

            <!-- Warm Status / Caption Badge -->
            <div class="w-full text-center pb-3">
              <Heading as="div" size="sub" align="center" spacing="none">
                Chanveasna ENG
              </Heading>
              <Paragraph variant="caption" align="center">
                Systems Design &bull; Automation &bull; Technical Strategy
              </Paragraph>
            </div>

            <!-- Action Button Under Headshot -->
            <div class="w-full justify-center">
              <MedievalDivider variant="feather" />
              <SecondaryButton href="#contact" className="w-full text-center">
                Initiate Discussion
              </SecondaryButton>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
