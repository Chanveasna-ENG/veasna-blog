---
import { primarySocialLinks } from '../../data/socials';
import MedievalFrame from '../common/MedievalFrame.astro';
import SectionHeader from '../common/SectionHeader.astro';
import Heading from '../ui/Heading.astro';
import Paragraph from '../ui/Paragraph.astro';
import PrimaryButton from '../ui/PrimaryButton.astro';
import SocialLink from '../ui/SocialLink.astro';
---

<section id="architect" class="w-full py-12 md:py-16 px-4 sm:px-6">
  <div class="max-w-6xl mx-auto">
    <!-- Outer Medieval Frame -->
    <MedievalFrame size="medium" background="transparent">

      <div
        class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center"
      >
        <!-- Left Column: Narrative, Philosophy & Social Channels (7 cols) -->
        <div class="lg:col-span-7 flex flex-col items-start text-left">
          <SectionHeader
            size="small"
            as="h2"
            headingSize="section"
            subtitle="About Me"
            title="Hi, I'm Veasna."
            divider="diamond"
          >
            <div class="space-y-4">
              <Paragraph variant="body">
                I am a software engineer focused on two things: building reliable
                web systems and automating daily business workflows. I help
                founders and small teams replace manual spreadsheet work, missed
                leads, and clunky tools with software that runs quietly in the
                background.
              </Paragraph>
              <Paragraph variant="body">
                Every system I deliver is straightforward to maintain, comes
                with clear documentation, and is built around your specific
                business processes—not bloated templates or fragile shortcuts.
              </Paragraph>
            </div>
          </SectionHeader>

          <!-- Social Links (4 core platforms) -->
          <div data-upwork-hide="true" class="mt-6 sm:mt-8">
            <div class="flex items-center gap-2.5">
              <Paragraph variant="body" color="ink" spacing="none">
                Direct Channels:
              </Paragraph>
              {
                primarySocialLinks.map((item) => (
                  <SocialLink platform={item.platform} href={item.href} />
                ))
              }
            </div>
          </div>
        </div>

        <!-- Right Column: Framed Headshot & Approachable Action (5 cols) -->
        <div class="lg:col-span-5 flex flex-col items-center">
          <!-- Portrait Frame Card -->
          <div
            class="w-full max-w-sm p-4 bg-parchment/40 border border-ink/30 relative flex flex-col items-center engraved-shadow"
          >
            <!-- Profile Image Container -->
            <div
              class="w-full aspect-[4/5] sm:aspect-square overflow-hidden border border-ink relative mb-4 group"
            >
              <img
                src="/images/profile.jpg"
                alt="Chanveasna ENG Headshot"
                class="w-full h-full object-cover contrast-105 transition-all duration-500"
                loading="lazy"
              />
              <div
                class="absolute inset-0 border-2 border-bronze/30 pointer-events-none"
              >
              </div>
            </div>

            <!-- Warm Status / Caption Badge -->
            <div class="w-full text-center pb-3">
              <Heading as="div" size="sub" align="center" spacing="none">
                Chanveasna ENG
              </Heading>
              <Paragraph variant="caption" align="center">
                Web Development &bull; Workflow Automation &bull; Custom Integrations
              </Paragraph>
            </div>

            <!-- Action Button Under Headshot -->
            <div class="w-full justify-center">
              <PrimaryButton href="/contact" fullWidth>
                Let's Talk About Your Project
              </PrimaryButton>
            </div>
          </div>
        </div>
      </div>
    </MedievalFrame>
  </div>
</section>
