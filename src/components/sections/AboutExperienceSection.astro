---
import SectionHeader from '../common/SectionHeader.astro';
import Heading from '../ui/Heading.astro';
import MedievalCorner from '../ui/MedievalCorner.astro';

const medievalCornerSize = 48;

const competencyCategories = [
  {
    title: 'Workflow & Integration Engines',
    icon: '/svg/sketch-blueprint.svg',
    skills: [
      'n8n Architecture & Self-Hosting',
      'Make.com & Zapier Workflows',
      'Custom Webhook Queue Buffers',
      'Autonomous CRM & Intake Sync',
      'API Reverse Engineering & Parsing'
    ]
  },
  {
    title: 'Messaging & Bot Ecosystems',
    icon: '/svg/sketch-shield.svg',
    skills: [
      'Telegram & Discord Bot Engineering',
      'WhatsApp Business API Flows',
      'Messenger & Instagram DM Triggers',
      'Persistent State Machines (SQLite/Postgres)',
      'Payment Webhooks & User Tiering'
    ]
  },
  {
    title: 'Web Platforms & AI Engineering',
    icon: '/svg/sketch-laptop.svg',
    skills: [
      'Astro, Next.js & React Frameworks',
      'Custom LLM Agents & Document RAG',
      'Docker Containerization & Linux VPS',
      'High-Speed E-Commerce & Portals',
      'Performance Optimization & Core Web Vitals'
    ]
  }
];
---

<section id="experience" class="w-full py-12 md:py-16 px-4 sm:px-6">
  <div class="max-w-6xl mx-auto">
    <!-- Section Header -->
    <SectionHeader
      subtitle="Technical Mastery"
      title="Core Competencies & Capabilities"
      description="Battle-tested engineering skills and proven system deployments crafted to eliminate operational bottlenecks."
    />

    <!-- 3-Column Competencies Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {competencyCategories.map((cat) => (
        <div class="medieval-frame p-7 relative bg-parchment/50 flex flex-col justify-between">
          <MedievalCorner position="top-left" size={medievalCornerSize} className="absolute top-1 left-1 text-ink" />
          <MedievalCorner position="top-right" size={medievalCornerSize} className="absolute top-1 right-1 text-ink" />
          <MedievalCorner position="bottom-left" size={medievalCornerSize} className="absolute bottom-1 left-1 text-ink" />
          <MedievalCorner position="bottom-right" size={medievalCornerSize} className="absolute bottom-1 right-1 text-ink" />

          <div>
            <div class="w-12 h-12 p-2 mb-5 border border-ink/40 flex items-center justify-center text-ink">
              <img src={cat.icon} alt={cat.title} class="w-full h-full object-contain" />
            </div>

            <Heading as="h3" size="card">
              {cat.title}
            </Heading>

            <ul class="space-y-2 border-t border-ink/10 pt-4">
              {cat.skills.map((skill) => (
                <li class="font-body text-xs text-ink flex items-center gap-2">
                  <span class="text-bronze font-bold">✓</span>
                  <span>{skill}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
