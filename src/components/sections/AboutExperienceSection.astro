---
import Checklist from '../common/Checklist.astro';
import MedievalFrame from '../common/MedievalFrame.astro';
import SectionHeader from '../common/SectionHeader.astro';
import Heading from '../ui/Heading.astro';

const competencyCategories = [
  {
    title: 'Workflow & Integration Engines',
    skills: [
      'n8n Setup & Self-Hosting',
      'Make & Zapier Automations',
      'Webhook Processing & Queue Buffers',
      'CRM & Lead Intake Sync',
      'REST API Integrations & Data Parsing'
    ]
  },
  {
    title: 'Messaging & Bot Ecosystems',
    skills: [
      'Telegram & Discord Bot Development',
      'WhatsApp Business API Automations',
      'Messenger & Instagram DM Automation',
      'Database State & Session Storage (PostgreSQL, SQLite)',
      'Payment Webhooks & Access Management'
    ]
  },
  {
    title: 'Web Platforms & Custom Tools',
    skills: [
      'Astro, Next.js & React Development',
      'LLM Integrations & Document Processing',
      'Docker Deployment & Linux VPS Management',
      'Custom Client Portals & Web Apps',
      'Performance Tuning & Core Web Vitals'
    ]
  }
];
---

<section id="experience" class="w-full py-12 md:py-16 px-4 sm:px-6">
  <div class="max-w-6xl mx-auto">
    <!-- Section Header -->
    <SectionHeader
      subtitle="Core Stack"
      title="Technical Capabilities & Tools"
      description="Core tools, frameworks, and deployment standards used across client projects."
    />

    <!-- 3-Column Competencies Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {competencyCategories.map((cat) => (
        <MedievalFrame size="small">
          <div>
            <Heading as="h3" size="card">
              {cat.title}
            </Heading>

            <Checklist items={cat.skills} bullet="check" borderTop={true} />
          </div>
        </MedievalFrame>
      ))}
    </div>
  </div>
</section>
