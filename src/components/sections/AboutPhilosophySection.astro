---
import MedievalFrame from '../common/MedievalFrame.astro';
import SectionHeader from '../common/SectionHeader.astro';
import Heading from '../ui/Heading.astro';
import MedievalDivider from '../ui/MedievalDivider.astro';
import Paragraph from '../ui/Paragraph.astro';
import SubtitleTag from '../ui/SubtitleTag.astro';

const values = [
  {
    num: '01',
    title: 'Automate Repetitive Work',
    description:
      'Manual data entry, copying leads, and routine notifications drain hours every week. If a task follows predictable rules, software should handle it in the background.'
  },
  {
    num: '02',
    title: 'Build for Reliability',
    description:
      'Silent automation failures waste time and lose leads. Every workflow and bot includes automated retries, error logging, and instant alerts so issues get caught before clients notice.'
  },
  {
    num: '03',
    title: 'Direct Access & Full Ownership',
    description:
      'You work directly with the engineer building your system—no account managers or communication delays. You get full access, clear handover documentation, and 100% ownership of every workflow and repository.'
  }
];
---

<section id="philosophy" class="w-full py-12 md:py-16 px-4 sm:px-6">
  <!-- Top Section Boundary Divider -->
  <MedievalDivider variant="diamond" />

  <div class="max-w-6xl mx-auto">
    <!-- Section Header -->
    <SectionHeader
      subtitle="Core Philosophy"
      title="Engineering Values That Drive Every Build"
      description="Good systems don't require daily supervision. I build automations and web platforms that handle routine work quietly, accurately, and without constant fixes."
    />

    <!-- 3-Pillar Narrative Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {values.map((val) => (
        <MedievalFrame size="small" interactive={true}>
          <div class="flex items-baseline justify-between mb-4">
            <span class="font-heading font-bold text-2xl text-bronze">
              {val.num}
            </span>
            <SubtitleTag variant="ghost" size="sm" color="ink" spacing="none">
              Principle
            </SubtitleTag>
          </div>

          <Heading as="h3" size="card" spacing="sm">
            {val.title}
          </Heading>

          <Paragraph variant="small">
            {val.description}
          </Paragraph>
        </MedievalFrame>
      ))}
    </div>
  </div>
</section>
