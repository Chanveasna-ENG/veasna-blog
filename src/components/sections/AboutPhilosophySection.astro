---
import Heading from '../ui/Heading.astro';
import MedievalCorner from '../ui/MedievalCorner.astro';
import MedievalDivider from '../ui/MedievalDivider.astro';
import Paragraph from '../ui/Paragraph.astro';
import SubtitleTag from '../ui/SubtitleTag.astro';

const medievalCornerSize = 48;

const values = [
  {
    num: '01',
    title: 'Autonomous Leverage (Zero Toil)',
    description:
      'Repetitive operational tasks and manual data entry are bottlenecks to growth. If a task happens twice, it should be engineered to run 24/7 autonomously without human fatigue.'
  },
  {
    num: '02',
    title: 'Deterministic Reliability & Failovers',
    description:
      'Fragile automations that break silently destroy trust. Every workflow, webhook queue, and messaging bot is constructed with retry mechanisms, state persistence, and real-time failure alerts.'
  },
  {
    num: '03',
    title: 'Quality Consistency & Clean Architecture',
    description:
      'Applying medieval craftsmanship to digital software engineering. Clean pipelines, strict typing, and modular architectures guarantee your systems scale smoothly without constant maintenance.'
  },
  {
    num: '04',
    title: 'Direct Partnership & Complete Ownership',
    description:
      'No middlemen, bloated agency overhead, or closed-garden lock-in. You receive transparent documentation, direct communication, and 100% ownership of your code, workflows, and infrastructure.'
  }
];
---

<section id="philosophy" class="w-full py-12 md:py-16 px-4 sm:px-6">
  <!-- Top Section Boundary Divider -->
  <MedievalDivider variant="diamond" />

  <div class="max-w-6xl mx-auto">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <SubtitleTag variant="bordered" size="sm" className="mb-3">
        Core Philosophy
      </SubtitleTag>
      <Heading as="h2" size="section" align="center">
        Engineering Values That Drive Every Build
      </Heading>
      <Paragraph variant="lead" align="center">
        Automation is not just about saving minutes—it is about establishing an unyielding foundation where your business operations run autonomously with predictable precision.
      </Paragraph>
      <MedievalDivider variant="feather" />
    </div>

    <!-- 4-Pillar Narrative Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {values.map((val) => (
        <div class="medieval-frame p-8 relative bg-parchment/70 group hover:border-bronze transition-colors">
          <MedievalCorner position="top-left" size={medievalCornerSize} className="absolute top-1 left-1 text-ink" />
          <MedievalCorner position="top-right" size={medievalCornerSize} className="absolute top-1 right-1 text-ink" />
          <MedievalCorner position="bottom-left" size={medievalCornerSize} className="absolute bottom-1 left-1 text-ink" />
          <MedievalCorner position="bottom-right" size={medievalCornerSize} className="absolute bottom-1 right-1 text-ink" />

          <div class="flex items-baseline justify-between mb-4">
            <span class="font-heading font-bold text-2xl text-bronze">
              {val.num}
            </span>
            <SubtitleTag variant="ghost" size="sm" color="ink">
              Principle
            </SubtitleTag>
          </div>

          <Heading as="h3" size="card" spacing="sm">
            {val.title}
          </Heading>

          <Paragraph variant="small">
            {val.description}
          </Paragraph>
        </div>
      ))}
    </div>
  </div>
</section>
