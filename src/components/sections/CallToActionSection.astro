---
import MedievalFrame from '../common/MedievalFrame.astro';
import SectionHeader from '../common/SectionHeader.astro';
import Paragraph from '../ui/Paragraph.astro';
import PrimaryButton from '../ui/PrimaryButton.astro';
import WaxSeal from '../ui/WaxSeal.astro';
---

<section id="cta" class="w-full py-12 md:py-16 px-4 sm:px-6">
  <div class="max-w-4xl mx-auto text-center">
    <MedievalFrame size="big" interactive={true}>
      <div class="mb-6 flex justify-center">
        <WaxSeal size="lg" text="CONFIDENTIAL" />
      </div>

      <SectionHeader
        size="big"
        as="h2"
        headingSize="section"
        title="Ready to Automate Your Busywork?"
        description="Let's talk through your current bottlenecks and map out a practical system that saves your team time."
        divider={false}
      />

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <PrimaryButton href="mailto:contact@chanveasna.eng" size="lg">
          Book a Free 15-Min Call &rarr;
        </PrimaryButton>
      </div>

      <div class="mt-6">
        <Paragraph variant="caption" align="center" spacing="none">
          No pressure sales pitch. Direct response within 24 business hours.
        </Paragraph>
      </div>
    </MedievalFrame>
  </div>
</section>
