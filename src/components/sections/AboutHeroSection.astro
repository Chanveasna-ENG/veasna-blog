---
import { primarySocialLinks } from '../../data/socials';
import MedievalFrame from '../common/MedievalFrame.astro';
import SectionHeader from '../common/SectionHeader.astro';
import Paragraph from '../ui/Paragraph.astro';
import PrimaryButton from '../ui/PrimaryButton.astro';
import SecondaryButton from '../ui/SecondaryButton.astro';
import SocialLink from '../ui/SocialLink.astro';
import WaxSeal from '../ui/WaxSeal.astro';
---

<section class="w-full py-12 md:py-16 px-4 sm:px-6 relative">
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      
      <!-- Left Column: Medieval Framed Portrait with Wax Seal -->
      <div class="lg:col-span-5 flex justify-center">
        <div class="relative w-full max-w-sm">
          <MedievalFrame size="medium" interactive={true}>
            <!-- Photo Container -->
            <div class="w-full aspect-[4/5] overflow-hidden border border-ink/40 relative group">
              <img
                src="/images/profile.jpg"
                alt="Chanveasna Eng - Systems Architect & Automation Specialist"
                class="w-full h-full object-cover object-center"
                loading="eager"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-ink/60 via-transparent to-transparent pointer-events-none"></div>
              
              <!-- Bottom Role Overlay -->
              <div class="absolute bottom-3 left-3 right-3 text-center">
                <span class="inline-block px-3 py-1 bg-parchment/90 border border-ink text-[11px] font-heading font-bold uppercase tracking-wider text-ink">
                  Systems Architect &amp; Automation
                </span>
              </div>
            </div>
          </MedievalFrame>

          <!-- Decorative Wax Seal Stamp overlapping the frame -->
          <div class="absolute -bottom-4 -right-4 sm:-bottom-5 sm:-right-5 z-20">
            <WaxSeal size="md" />
          </div>
        </div>
      </div>

      <!-- Right Column: Narrative Bio & Strategy Call CTA -->
      <div class="lg:col-span-7 flex flex-col items-start justify-center">
        <SectionHeader
          size="small"
          as="h1"
          headingSize="hero"
          subtitle="Digital Systems Architect & Automation Specialist"
          title="Hi, I'm Veasna."
        >
          <div class="space-y-4">
            <Paragraph variant="lead">
              I build custom web applications, workflow automations, and messaging bots. My focus is helping businesses cut manual data entry and connect their tools so work moves without bottlenecks.
            </Paragraph>
            <Paragraph variant="body" spacing="sm">
              Instead of fragile, quick-fix setups, I build systems designed to stay up and run reliably: backend workflows (n8n, Make), messaging bots (Telegram, Discord, WhatsApp), and fast web apps (Astro, Next.js). Everything comes with clear documentation and full code ownership.
            </Paragraph>
          </div>
        </SectionHeader>

        <!-- Social Channels -->
        <div data-upwork-hide="true" class="my-4 flex items-center justify-center sm:justify-start gap-3 w-full">
          {
            primarySocialLinks.map((item) => (
              <SocialLink platform={item.platform} href={item.href} size="md" />
            ))
          }
        </div>

        <!-- Action Buttons Row -->
        <div class="pt-3 flex flex-col sm:flex-row items-center justify-center sm:justify-start gap-4 w-full">
          <PrimaryButton href="/book-a-call" size="lg">
            Book Strategy Call
          </PrimaryButton>
          <SecondaryButton href="#portfolio" size="md">
            View Recent Projects
          </SecondaryButton>
        </div>

      </div>

    </div>
  </div>
</section>
