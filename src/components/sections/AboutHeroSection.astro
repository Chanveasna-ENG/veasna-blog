---
import Heading from '../ui/Heading.astro';
import MedievalCorner from '../ui/MedievalCorner.astro';
import Paragraph from '../ui/Paragraph.astro';
import PrimaryButton from '../ui/PrimaryButton.astro';
import SecondaryButton from '../ui/SecondaryButton.astro';
import SubtitleTag from '../ui/SubtitleTag.astro';
import WaxSeal from '../ui/WaxSeal.astro';

const medievalCornerSize = 69;

const socials = [
  {
    name: 'GitHub',
    href: 'https://github.com/chanveasna-eng',
    icon: '/svg/icon-github.svg'
  },
  {
    name: 'LinkedIn',
    href: 'https://linkedin.com/in/chanveasna-eng',
    icon: '/svg/icon-linkedin.svg'
  },
  { name: 'Upwork', href: 'https://upwork.com', icon: '/svg/icon-upwork.svg' },
  {
    name: 'Email',
    href: 'mailto:contact@chanveasna.eng',
    icon: '/svg/icon-email.svg'
  }
];
---

<section class="w-full py-12 md:py-16 px-4 sm:px-6 relative">
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      
      <!-- Left Column: Medieval Framed Portrait with Wax Seal -->
      <div class="lg:col-span-5 flex justify-center">
        <div class="relative w-full max-w-sm">
          <div class="medieval-frame p-6 sm:p-7 relative bg-parchment/60 engraved-shadow">
            <MedievalCorner position="top-left" size={medievalCornerSize} className="absolute top-1 left-1 text-ink" />
            <MedievalCorner position="top-right" size={medievalCornerSize} className="absolute top-1 right-1 text-ink" />
            <MedievalCorner position="bottom-left" size={medievalCornerSize} className="absolute bottom-1 left-1 text-ink" />
            <MedievalCorner position="bottom-right" size={medievalCornerSize} className="absolute bottom-1 right-1 text-ink" />

            <!-- Photo Container -->
            <div class="w-full aspect-[4/5] overflow-hidden border border-ink/40 relative group">
              <img
                src="/images/profile.jpg"
                alt="Chanveasna Eng - Systems Architect & Automation Specialist"
                class="w-full h-full object-cover object-center"
                loading="eager"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-ink/60 via-transparent to-transparent pointer-events-none"></div>
              
              <!-- Bottom Role Overlay -->
              <div class="absolute bottom-3 left-3 right-3 text-center">
                <span class="inline-block px-3 py-1 bg-parchment/90 border border-ink text-[11px] font-heading font-bold uppercase tracking-wider text-ink">
                  Systems Architect &amp; Automation
                </span>
              </div>
            </div>
          </div>

          <!-- Decorative Wax Seal Stamp overlapping the frame -->
          <div class="absolute -bottom-4 -right-4 sm:-bottom-5 sm:-right-5 z-20">
            <WaxSeal size="md" />
          </div>
        </div>
      </div>

      <!-- Right Column: Narrative Bio & Strategy Call CTA -->
      <div class="lg:col-span-7 flex flex-col justify-center">
        <SubtitleTag variant="bordered" size="sm" className="mb-4 self-start">
          Architect Profile
        </SubtitleTag>

        <Heading as="h1" size="hero" className="mb-4 leading-tight">
          Hi, I'm Veasna.
        </Heading>

        <Heading as="h2" size="sub" color="bronze" className="mb-6 font-semibold">
          Digital Systems Architect &amp; Automation Specialist
        </Heading>

        <Paragraph variant="lead" className="mb-6 leading-relaxed">
          I build high-converting web applications, resilient automation pipelines, and autonomous messaging bots that eliminate repetitive manual labor and help businesses operate with ruthless efficiency.
        </Paragraph>

        <Paragraph variant="muted" className="mb-8 leading-relaxed text-sm sm:text-base">
          Rather than gluing together fragile tools, I approach every project with engineering discipline: designing deterministic workflows (n8n, Make, Zapier), intelligent chat integrations (Telegram, Discord, WhatsApp), and high-speed web architectures (Astro, Next.js) built for high uptime and long-term scalability.
        </Paragraph>

        <!-- CTA Buttons & Social Links Row -->
        <div class="flex flex-col sm:flex-row sm:items-center gap-6 pt-2">
          <div class="flex items-center gap-3">
            <PrimaryButton href="#contact" size="md">
              Book Strategy Call
            </PrimaryButton>
            <SecondaryButton href="#portfolio" className="text-xs py-2.5 px-4">
              View Work &rarr;
            </SecondaryButton>
          </div>

          <!-- Social Icons -->
          <div class="flex items-center gap-3">
            {socials.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.name}
                class="w-9 h-9 border border-ink/40 p-2 flex items-center justify-center hover:border-bronze hover:bg-parchmentDark transition-colors group"
              >
                <img src={social.icon} alt={social.name} class="w-full h-full object-contain filter group-hover:brightness-75 transition-all" />
              </a>
            ))}
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
