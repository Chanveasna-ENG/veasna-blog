---
import Checklist from '../common/Checklist.astro';
import MedievalFrame from '../common/MedievalFrame.astro';
import SectionHeader from '../common/SectionHeader.astro';
import Heading from '../ui/Heading.astro';
import Paragraph from '../ui/Paragraph.astro';
import PrimaryButton from '../ui/PrimaryButton.astro';
import SubtitleTag from '../ui/SubtitleTag.astro';

const services = [
  {
    id: 'workflow-automation',
    title: 'Workflow & Tool Integration',
    icon: '/svg/sketch-blueprint.svg',
    tag: 'Automation',
    description:
      'Connect your apps and automate repetitive processes so data flows between your CRM, forms, and tools without manual copy-pasting.',
    highlights: [
      'n8n, Make.com, and Zapier setups',
      'Automatic CRM and lead intake routing',
      'Reliable webhook error handling and alerts',
      'Automated invoice, email, and task triggers'
    ],
    ctaSubject: 'Workflow Automation (n8n / Make / Zapier)'
  },
  {
    id: 'messaging-bots',
    title: 'Custom Bots & Chat Automations',
    icon: '/svg/sketch-shield.svg',
    tag: 'Messaging',
    description:
      'Build smart chat assistants that answer customer questions, qualify inquiries, and alert your team directly in messaging apps.',
    highlights: [
      'Telegram, Discord, and WhatsApp bots',
      'Automated Instagram and Facebook DM replies',
      'Database storage for customer responses',
      'Stripe and third-party API integrations'
    ],
    ctaSubject: 'Messaging & Social Bots (Telegram / Discord / WhatsApp)'
  },
  {
    id: 'ai-web-apps',
    title: 'Custom Web Applications & Sites',
    icon: '/svg/sketch-laptop.svg',
    tag: 'Web Development',
    description:
      'Fast, clean web applications and landing pages built to load quickly, rank well on search engines, and turn visitors into inquiries.',
    highlights: [
      'Modern Astro, Next.js, and React builds',
      'Fast load times (95+ Google Lighthouse scores)',
      'Internal dashboards and customer portals',
      'Optional AI search and assistant integrations'
    ],
    ctaSubject: 'AI Systems & Custom Web Apps (Astro / Next.js / E-Commerce)'
  }
];
---

<section id="services" class="w-full py-12 md:py-16 px-4 sm:px-6">
  <div class="max-w-6xl mx-auto">
    <!-- Section Header -->
    <SectionHeader
      subtitle="What I Do"
      title="Three Ways I Can Help Your Business"
      description="Practical development and automation services tailored to solve specific operational headaches."
    />

    <!-- 3-Column Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {services.map((service) => (
        <MedievalFrame size="medium" interactive={true}>
          <div>
            <div class="flex items-center justify-between mb-6">
              <!-- Sketch Icon Container -->
              <div class="w-14 h-14 p-2.5 bg-transparent border border-ink/40 flex items-center justify-center text-ink group-hover:text-bronze transition-colors">
                <img src={service.icon} alt={service.title} class="w-full h-full object-contain" />
              </div>
              <SubtitleTag variant="badge" size="sm" color="bronze" spacing="none">
                {service.tag}
              </SubtitleTag>
            </div>

            <!-- Title -->
            <Heading as="h3" size="card" spacing="sm">
              {service.title}
            </Heading>

            <!-- Description -->
            <Paragraph variant="small">
              {service.description}
            </Paragraph>
          </div>

          <div>
            <!-- Feature Bullet List -->
            <div class="mb-6">
              <Checklist items={service.highlights} bullet="check" borderTop={true} />
            </div>

            <!-- Scoping CTA Link -->
            <div class="pt-2">
              <PrimaryButton
                href={`/contact?subject=${encodeURIComponent(service.ctaSubject)}`}
                size="sm"
                fullWidth
              >
                Inquire Service &rarr;
              </PrimaryButton>
            </div>
          </div>
        </MedievalFrame>
      ))}
    </div>

  </div>
</section>
