---
import MedievalCorner from '../ui/MedievalCorner.astro';
import MedievalDivider from '../ui/MedievalDivider.astro';
import SubtitleTag from '../ui/SubtitleTag.astro';
import Heading from '../ui/Heading.astro';
import Paragraph from '../ui/Paragraph.astro';

const medievalCornerSize = 69;

const caseStudies = [
  {
    title: 'Automating Mass Content Distribution & Social Intake',
    category: 'Automation Strategy',
    problem:
      'Manual multi-platform content publishing was consuming 25+ hours weekly per team member, leading to delays and inconsistent lead tracking.',
    solution:
      'Engineered an autonomous webhook pipeline with queue management that processes, formats, and publishes posts seamlessly with zero manual overhead.',
    impact:
      'Saved 100+ hours monthly and accelerated campaign execution speed by 400%.'
  },
  {
    title: 'High-Availability Infrastructure for Custom Web Portals',
    category: 'Web & Architecture',
    problem:
      'Legacy server setups suffered intermittent downtime during traffic spikes, losing potential client leads.',
    solution:
      'Designed and deployed containerized microservices behind nginx proxy with automated health-checks and instant failover.',
    impact:
      'Achieved 99.99% uptime during launch campaigns and reduced page load times under 400ms.'
  }
];
---

<section id="case-studies" class="w-full py-16 px-4 sm:px-6 bg-transparent">
  <div class="max-w-6xl mx-auto">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <Heading as="h2" size="section" align="center" className="mb-4">
        Featured Outcomes
      </Heading>
      <Paragraph variant="lead" align="center">
        Real-world business transformation stories framed around problem solving
        and measurable ROI.
      </Paragraph>
      <MedievalDivider variant="feather" className="mt-4" />
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        caseStudies.map((study) => (
          <div class="medieval-frame p-8 relative flex flex-col justify-between">
            <MedievalCorner
              position="top-left"
              size={medievalCornerSize}
              className="absolute top-1 left-1 text-ink"
            />
            <MedievalCorner
              position="top-right"
              size={medievalCornerSize}
              className="absolute top-1 right-1 text-ink"
            />

            <div>
              <SubtitleTag variant="ghost" size="sm" className="mb-2">
                {study.category}
              </SubtitleTag>
              <Heading as="h3" size="card" className="mb-4">
                {study.title}
              </Heading>

              <div class="space-y-3 font-body text-sm text-inkMuted mb-6">
                <div>
                  <strong class="text-ink font-heading text-base block mb-1">
                    Challenge:
                  </strong>
                  <Paragraph variant="muted">{study.problem}</Paragraph>
                </div>
                <div>
                  <strong class="text-ink font-heading text-base block mb-1">
                    Architectural Solution:
                  </strong>
                  <Paragraph variant="muted">{study.solution}</Paragraph>
                </div>
              </div>
            </div>

            <div class="p-4 bg-transparent border-l-4 border-bronze text-ink font-heading text-base font-bold">
              <span class="text-bronze mr-1">Impact:</span> {study.impact}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
