---
import MedievalFrame from '../common/MedievalFrame.astro';
import SectionHeader from '../common/SectionHeader.astro';
---

<section class="w-full py-12 md:py-16 px-4 sm:px-6 relative">
  <div class="max-w-5xl mx-auto flex flex-col items-center">
    <!-- Header Section -->
    <SectionHeader
      size="normal"
      as="h1"
      headingSize="hero"
      paragraphVariant="lead"
      subtitle="Direct Calendar Scheduling"
      title="Book Your Strategy Call"
      description="Choose a convenient time below for a 15-minute discovery call. We will evaluate your current workflow, identify manual bottlenecks, and map out a practical technical plan."
      divider="feather"
    />

    <!-- Embedded Google Calendar Appointment Scheduling Container -->
    <div class="w-full max-w-5xl mt-6 sm:mt-8">
      <MedievalFrame size="small" background="parchment">
        <div class="w-full -mx-4 sm:mx-0 overflow-hidden rounded-sm">
          <iframe
            src="https://calendar.google.com/calendar/appointments/schedules/AcZssZ29gRfCKxg9Ev502rPc_9Ax4EC4zX7Rs2VJD84PfbpqDjFtfwAHwC35oEAAdFTjY_9xnKGyRZlH?gv=true"
            style="border: 0; mix-blend-mode: multiply; filter: hue-rotate(185deg) contrast(105%) sepia(25%);"
            width="100%"
            height="1350"
            title="Google Calendar Appointment Scheduling"
            class="w-full h-[1350px] sm:h-[950px] md:h-[760px] border-0"
          ></iframe>
        </div>
      </MedievalFrame>
    </div>
  </div>
</section>
