---
import MedievalFrame from '../common/MedievalFrame.astro';
import SectionHeader from '../common/SectionHeader.astro';
import PrimaryButton from '../ui/PrimaryButton.astro';
import SecondaryButton from '../ui/SecondaryButton.astro';
---

<section class="w-full py-12 md:py-16 px-4 sm:px-6 relative overflow-hidden">
  <div class="max-w-4xl mx-auto text-center relative z-10">
    <!-- Outer Medieval Line Frame Container -->
    <MedievalFrame size="big" background="transparent">
      <SectionHeader
        size="big"
        subtitle="Web Development & Workflow Automation"
        title="Custom Websites & Automations Built for Growing Businesses"
        description="I build fast web applications and connect your business tools—so your site loads fast, your leads get handled instantly, and your team stops wasting hours on manual data entry."
      />

      <!-- Primary & Secondary CTA Buttons -->
      <div
        class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-6"
      >
        <PrimaryButton href="/contact" size="lg">
          Book a Free Discovery Call
        </PrimaryButton>
        <SecondaryButton href="#portfolio">
          View Recent Projects
        </SecondaryButton>
      </div>
    </MedievalFrame>
  </div>
</section>
