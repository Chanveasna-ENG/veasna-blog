---
import SectionHeader from '../common/SectionHeader.astro';
import MedievalCorner from '../ui/MedievalCorner.astro';
import PrimaryButton from '../ui/PrimaryButton.astro';
import SecondaryButton from '../ui/SecondaryButton.astro';

const medievalCornerSize = 150;
---

<section class="w-full py-12 md:py-16 px-4 sm:px-6 relative overflow-hidden">
  <div class="max-w-4xl mx-auto text-center relative z-10">
    <!-- Outer Medieval Line Frame Container -->
    <div class="medieval-frame p-8 sm:p-12 md:p-16 relative">
      <MedievalCorner
        position="top-left"
        size={medievalCornerSize}
        className="absolute top-1 left-1 text-ink"
      />
      <MedievalCorner
        position="top-right"
        size={medievalCornerSize}
        className="absolute top-1 right-1 text-ink"
      />
      <MedievalCorner
        position="bottom-left"
        size={medievalCornerSize}
        className="absolute bottom-1 left-1 text-ink"
      />
      <MedievalCorner
        position="bottom-right"
        size={medievalCornerSize}
        className="absolute bottom-1 right-1 text-ink"
      />

      <SectionHeader
        size="big"
        subtitle="Digital Realm Builder & Workflow Architect"
        title="Forging Scalable Web Systems & Autonomous Workflows"
        description="I design high-converting web applications and engineered automation pipelines that scale operations, capture enterprise leads, and eliminate repetitive toil."
      />

      <!-- Primary & Secondary CTA Buttons -->
      <div
        class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-6"
      >
        <PrimaryButton href="#contact" size="lg">
          Book Consultation
        </PrimaryButton>
        <SecondaryButton href="#case-studies">
          Explore Outcomes
        </SecondaryButton>
      </div>
    </div>
  </div>
</section>
