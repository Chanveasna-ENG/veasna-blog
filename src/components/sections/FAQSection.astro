---
import Accordion, { type AccordionItem } from '../common/Accordion.astro';
import SectionHeader from '../common/SectionHeader.astro';

interface Props {
  items?: AccordionItem[];
}

const defaultFAQItems: AccordionItem[] = [
  {
    question: 'What kind of projects do you take on?',
    answer:
      'I build custom websites and web apps (using Astro, Next.js, and React), automate workflows between business apps (via n8n, Make, and Zapier), and build custom bots for messaging platforms like Telegram and Discord.'
  },
  {
    question: 'How long does a typical project take?',
    answer:
      'Most automation setups take 1 to 2 weeks. Custom bots and web applications typically take 2 to 4 weeks, depending on the complexity of integrations and features.'
  },
  {
    question:
      'Will my team be able to use and maintain the system after launch?',
    answer:
      'Yes. I provide recorded video tutorials and written step-by-step guides for your team so you can own and run your setup without being tied to a developer for daily changes.'
  },
  {
    question: 'What happens if something breaks after launch?',
    answer:
      'Every project includes 30 days of post-launch support. If an integration hiccups or a bug appears during that period, I fix it at no extra charge.'
  },
  {
    question: 'How do we get started?',
    answer:
      'Send an inquiry through the contact form or book a free 15-minute call. We will discuss what you need, confirm if I am the right fit, and give you an exact price and timeline.'
  }
];

const { items = defaultFAQItems } = Astro.props;
---

<section id="faq" class="w-full py-12 md:py-16 px-4 sm:px-6">
  <div class="max-w-4xl mx-auto">
    <!-- Centered Header Block -->
    <SectionHeader
      subtitle="FAQ"
      title="Frequently Asked Questions"
    />

    <!-- Reusable Accordion Component -->
    <Accordion items={items} />
  </div>
</section>
