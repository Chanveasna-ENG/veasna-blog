---
import MedievalFrame from '../common/MedievalFrame.astro';
import Paragraph from '../ui/Paragraph.astro';

interface Props {
  quote?: string;
  author?: string;
}

const {
  quote = 'True digital architecture does not demand constant babysitting. It hums silently in the background, reliably capturing leads, syncing data, and converting visitors into loyal clients.',
  author = 'Chanveasna ENG'
} = Astro.props;
---

<section class="w-full py-12 md:py-16 px-4 sm:px-6">
  <div class="max-w-4xl mx-auto">
    <MedievalFrame size="small" interactive={true}>

      <blockquote class="m-0 p-0">
        <Paragraph
          variant="lead"
          align="center"
          color="ink"
        >
          "{quote}"
        </Paragraph>
        <footer class="flex items-center justify-center gap-4">
          <span class="w-10 sm:w-14 h-[1px] bg-bronze/60"></span>
          <cite
            class="font-heading font-bold uppercase tracking-widest text-xs sm:text-sm text-bronze not-italic"
          >
            {author}
          </cite>
          <span class="w-10 sm:w-14 h-[1px] bg-bronze/60"></span>
        </footer>
      </blockquote>
    </MedievalFrame>
  </div>
</section>
