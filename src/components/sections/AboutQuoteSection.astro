---
import MedievalCorner from '../ui/MedievalCorner.astro';

interface Props {
  quote?: string;
  author?: string;
}

const {
  quote = 'True digital architecture does not demand constant babysitting. It hums silently in the background, reliably capturing leads, syncing data, and converting visitors into loyal clients.',
  author = 'Chanveasna ENG'
} = Astro.props;

const medievalCornerSize = 48;
---

<section class="w-full py-12 md:py-16 px-4 sm:px-6">
  <div class="max-w-4xl mx-auto">
    <div
      class="medieval-frame p-8 sm:p-12 relative bg-parchment/70 text-center engraved-shadow"
    >
      <MedievalCorner
        position="top-left"
        size={medievalCornerSize}
        className="absolute top-1 left-1 text-ink"
      />
      <MedievalCorner
        position="top-right"
        size={medievalCornerSize}
        className="absolute top-1 right-1 text-ink"
      />
      <MedievalCorner
        position="bottom-left"
        size={medievalCornerSize}
        className="absolute bottom-1 left-1 text-ink"
      />
      <MedievalCorner
        position="bottom-right"
        size={medievalCornerSize}
        className="absolute bottom-1 right-1 text-ink"
      />

      <blockquote class="m-0 p-0">
        <p
          class="font-heading text-xl sm:text-2xl md:text-3xl text-ink font-semibold italic leading-relaxed mb-6"
        >
          "{quote}"
        </p>
        <footer class="flex items-center justify-center gap-4">
          <span class="w-10 sm:w-14 h-[1px] bg-bronze/60"></span>
          <cite
            class="font-heading font-bold uppercase tracking-widest text-xs sm:text-sm text-bronze not-italic"
          >
            {author}
          </cite>
          <span class="w-10 sm:w-14 h-[1px] bg-bronze/60"></span>
        </footer>
      </blockquote>
    </div>
  </div>
</section>
