---
import { getCollection } from 'astro:content';
import ProjectCard from '../common/ProjectCard.astro';
import SectionHeader from '../common/SectionHeader.astro';
import SecondaryButton from '../ui/SecondaryButton.astro';

// 1. Fetch non-draft projects
const projects = await getCollection(
  'blog',
  (post) => !post.data.draft && post.data.category === 'project'
);

// Sort newest first
const sortedProjects = projects.sort((a, b) => {
  const dateA = a.data.lastModifiedAt || a.data.createdAt;
  const dateB = b.data.lastModifiedAt || b.data.createdAt;
  return dateB.getTime() - dateA.getTime();
});
---

<section id="portfolio" class="w-full py-12 md:py-16 px-4 sm:px-6">

  <SectionHeader
    subtitle="Proven Outcomes & Architecture"
    title="Building Systems That Drive Results"
    description="Explore production web platforms, custom microservices, and autonomous integration workflows engineered for scalability and measurable business ROI."
  />

  <!-- Draggable Horizontal Scroll-Snap Container -->
  <div class="w-full max-w-6xl mx-auto relative">
    <div
      id="portfolio-scroll-container"
      class="flex items-stretch overflow-x-auto snap-x snap-mandatory gap-6 pb-6 pt-2 px-1 scroll-smooth select-none cursor-grab active:cursor-grabbing scrollbar-none"
    >
      {
        sortedProjects.map((item) => (
          <div class="w-[300px] sm:w-[380px] md:w-[420px] flex-shrink-0 snap-start pointer-events-auto flex">
            <ProjectCard
              project={{
                id: item.id,
                title: item.data.title,
                description: item.data.description,
                tags: item.data.tags,
                coverImageSrc: item.data.coverImage?.src
              }}
              variant="slider"
            />
          </div>
        ))
      }
    </div>

    <!-- Centered Bottom CTA Button -->
    <div class="flex justify-center mt-10">
      <SecondaryButton href="/portfolio">
        View All Work &rarr;
      </SecondaryButton>
    </div>
  </div>
</section>

<script>
  function setupPortfolioDrag() {
    const slider = document.getElementById('portfolio-scroll-container');
    if (!slider) return;

    let isDown = false;
    let startX = 0;
    let scrollLeft = 0;
    let hasDragged = false;

    slider.addEventListener('mousedown', (e) => {
      isDown = true;
      hasDragged = false;
      slider.classList.add('cursor-grabbing');
      slider.classList.remove('scroll-smooth', 'snap-x', 'snap-mandatory');
      startX = e.pageX - slider.offsetLeft;
      scrollLeft = slider.scrollLeft;
    });

    slider.addEventListener('mouseleave', () => {
      if (!isDown) return;
      isDown = false;
      slider.classList.remove('cursor-grabbing');
      slider.classList.add('scroll-smooth', 'snap-x', 'snap-mandatory');
    });

    slider.addEventListener('mouseup', () => {
      if (!isDown) return;
      isDown = false;
      slider.classList.remove('cursor-grabbing');
      slider.classList.add('scroll-smooth', 'snap-x', 'snap-mandatory');
    });

    slider.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - slider.offsetLeft;
      const walk = (x - startX) * 1.5; // Drag sensitivity
      if (Math.abs(walk) > 6) {
        hasDragged = true;
      }
      slider.scrollLeft = scrollLeft - walk;
    });

    // Suppress link click when dragging
    slider.querySelectorAll('.portfolio-card-link').forEach((link) => {
      link.addEventListener('click', (e) => {
        if (hasDragged) {
          e.preventDefault();
        }
      });
    });
  }

  // Setup on initial load and view transitions
  setupPortfolioDrag();
  document.addEventListener('astro:after-swap', setupPortfolioDrag);
</script>
