---
import MedievalFrame from '../common/MedievalFrame.astro';
import SectionHeader from '../common/SectionHeader.astro';
import Heading from '../ui/Heading.astro';
import Paragraph from '../ui/Paragraph.astro';
import SubtitleTag from '../ui/SubtitleTag.astro';

const steps = [
  {
    step: '01',
    title: 'Scope & Plan',
    description:
      'We discuss your current bottlenecks, agree on exact deliverables, and set a clear timeline and price before writing any code.',
    image: '/images/profile.jpg',
    imageAlt: 'Architecture Discovery & Planning'
  },
  {
    step: '02',
    title: 'Build & Review',
    description:
      'I build your system in milestones and share live staging previews so you can test and give feedback as we go.',
    image: '/images/profile.jpg',
    imageAlt: 'Iterative Engineering & Feedback'
  },
  {
    step: '03',
    title: 'Handover & Support',
    description:
      'You get recorded video walkthroughs, documentation, and 30 days of direct support to make sure everything runs smoothly in production.',
    image: '/images/profile.jpg',
    imageAlt: 'Handover & Documentation'
  }
];
---

<section id="process" class="w-full py-12 md:py-16 px-4 sm:px-6">  
  <div class="max-w-6xl mx-auto">
    <!-- Section Header -->
    <SectionHeader
      subtitle="How It Works"
      title="Simple, Predictable Process"
    />

    <!-- 3-Column Step Process Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {
        steps.map((item) => (
          <MedievalFrame size="small" interactive={true}>
            <div>
              <div class="flex items-baseline justify-between mb-4">
                <span class="font-heading font-bold text-2xl text-bronze">
                  {item.step}
                </span>
                <SubtitleTag variant="ghost" size="sm" color="ink" spacing="none">
                  Stage
                </SubtitleTag>
              </div>

              <Heading as="h3" size="card" spacing="sm">
                {item.title}
              </Heading>

              <Paragraph variant="small">
                {item.description}
              </Paragraph>
            </div>

            <!-- Visual Preview Mockup Box -->
            <div class="w-full aspect-[16/10] overflow-hidden border border-ink/30 relative mt-auto bg-parchmentDark/40">
              <img
                src={item.image}
                alt={item.imageAlt}
                class="w-full h-full object-cover"
                loading="lazy"
              />
              <div class="absolute inset-0 border border-bronze/20 pointer-events-none" />
            </div>
          </MedievalFrame>
        ))
      }
    </div>
  </div>
</section>
