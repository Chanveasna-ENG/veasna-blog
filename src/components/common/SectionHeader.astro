---
import Heading from '../ui/Heading.astro';
import MedievalDivider from '../ui/MedievalDivider.astro';
import Paragraph from '../ui/Paragraph.astro';
import SubtitleTag from '../ui/SubtitleTag.astro';
import {
  type SectionHeaderProps,
  resolveHeaderConfig
} from './section-header.utils';

interface Props extends SectionHeaderProps {}

const { subtitle, title, description, clampTitle, clampDescription } =
  Astro.props;

const hasSlot = Astro.slots.has('default');
const hasDescription = Boolean(description || hasSlot);
const config = resolveHeaderConfig(Astro.props, hasDescription);
const isBig = Astro.props.size === 'big';
---

<div class={config.containerClass}>
  {Boolean(subtitle) && (
    <SubtitleTag
      variant={config.subtitleVariant}
      size={config.subtitleSize}
      spacing={config.subtitleSpacing}
    >
      {subtitle}
    </SubtitleTag>
  )}

  <Heading
    as={config.as}
    size={config.headingSize}
    align={config.align}
    spacing={config.headingSpacing}
    clamp={clampTitle}
  >
    {title}
  </Heading>

  {hasDescription && (
    description ? (
      isBig ? (
        <div class="max-w-2xl mx-auto">
          <Paragraph
            variant={config.paragraphVariant}
            align={config.align}
            clamp={clampDescription}
            spacing={config.paragraphSpacing}
          >
            {description}
          </Paragraph>
        </div>
      ) : (
        <Paragraph
          variant={config.paragraphVariant}
          align={config.align}
          clamp={clampDescription}
          spacing={config.paragraphSpacing}
        >
          {description}
        </Paragraph>
      )
    ) : (
      <slot />
    )
  )}

  {config.showDivider && <MedievalDivider variant={config.dividerVariant} />}
</div>
