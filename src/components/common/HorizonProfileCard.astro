---
import Heading from '../ui/Heading.astro';
import Paragraph from '../ui/Paragraph.astro';
import PrimaryButton from '../ui/PrimaryButton.astro';

interface Props {
  name?: string;
  role?: string;
  bio?: string;
  imageUrl?: string;
  email?: string;
}

const {
  name = 'Chanveasna Eng',
  role = 'Systems Architect & Automation Specialist',
  bio = 'I design and build reliable web systems, workflow automations, and custom bots that replace manual data entry and keep operations running smoothly.',
  imageUrl = '/images/profile.jpg', // Ensure this image exists in public/images/
  email = '/contact'
} = Astro.props;
---

<div class="w-full bg-darkBg border border-gray-700 rounded-xl shadow-md overflow-hidden p-6 md:p-8 hover:border-gold transition-colors duration-300">
  <div class="grid grid-cols-1 md:grid-cols-[auto_1fr] gap-8 items-center">
    
    {/* Left Side: Image */}
    <div class="flex justify-center md:justify-start">
      <div class="w-32 h-32 md:w-40 md:h-40 overflow-hidden rounded-full border-4 border-gold shadow-lg flex-shrink-0">
        <img 
          src={imageUrl} 
          alt={`Profile picture of ${name}`} 
          class="w-full h-full object-cover"
          loading="lazy"
        />
      </div>
    </div>

    {/* Right Side: Content */}
    <div class="flex flex-col text-center md:text-left">
      <Heading as="h2" size="section" color="bronze" spacing="xs">{name}</Heading>
      <Paragraph variant="caption" color="inkMuted" spacing="sm">
        {role}
      </Paragraph>
      
      <div class="max-w-2xl mb-6">
        <Paragraph variant="body" color="inkMuted" spacing="none">
          {bio}
        </Paragraph>
      </div>

      {/* Action */}
      <div class="mt-auto">
        <PrimaryButton href={email} size="md">
          Get in Touch &rarr;
        </PrimaryButton>
      </div>
    </div>
    
  </div>
</div>