---
interface Props {
  id?: string;
  clearId?: string;
  placeholder?: string;
  className?: string;
}

const {
  id = 'search-input',
  clearId = 'search-clear',
  placeholder = 'Search by keyword, topic, or tech...',
  className = ''
} = Astro.props;
---

<div class={`w-full max-w-4xl mx-auto my-8 flex flex-col items-center ${className}`}>
  <div class="relative w-full max-w-xl">
    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-inkMuted">
      <svg
        class="w-4 h-4"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="2"
        stroke="currentColor"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"
        />
      </svg>
    </div>

    <input
      type="text"
      id={id}
      placeholder={placeholder}
      class="w-full bg-parchmentDark/40 border border-ink/40 focus:border-bronze focus:ring-1 focus:ring-bronze text-ink placeholder-inkMuted/60 pl-10 pr-10 py-2.5 rounded-none text-sm font-body outline-none transition-colors shadow-inner"
      autocomplete="off"
      spellcheck="false"
      aria-label="Filter content by keyword"
    />

    {clearId && (
      <button
        type="button"
        id={clearId}
        class="hidden absolute inset-y-0 right-0 pr-3 flex items-center text-inkMuted hover:text-ink transition-colors cursor-pointer text-base font-bold focus:outline-none"
        aria-label="Clear search input"
      >
        &times;
      </button>
    )}
  </div>
</div>
