---
import { primarySocialLinks } from '../../data/socials';
import PrimaryButton from '../ui/PrimaryButton.astro';
import SocialLink from '../ui/SocialLink.astro';
import MedievalFrame from './MedievalFrame.astro';
import SectionHeader from './SectionHeader.astro';

interface Props {
  name?: string;
  role?: string;
  bio?: string;
  imageUrl?: string;
}

const {
  name = 'Chanveasna Eng',
  role = 'Digital Systems Architect & Automation Specialist',
  bio = 'I build custom web applications, workflow automations, and messaging bots that eliminate manual data entry and keep business tools reliably in sync.',
  imageUrl = '/images/profile.jpg'
} = Astro.props;
---

<div class="w-full author-profile-card">
  <MedievalFrame size="small" background="parchment">
    <div class="grid grid-cols-1 md:grid-cols-[auto_1fr] gap-6 md:gap-8 items-center p-3 sm:p-5">
      <!-- Left: Sharp Headshot Box (clean border, zero shadow) -->
      <div class="flex justify-center md:justify-start">
        <div class="w-28 h-28 sm:w-32 sm:h-32 overflow-hidden border border-ink relative bg-parchmentDark/40 flex-shrink-0">
          <img
            src={imageUrl}
            alt={`${name} Headshot`}
            class="w-full h-full object-cover contrast-105"
            loading="lazy"
          />
        </div>
      </div>

      <!-- Right: SectionHeader, Socials & CTA -->
      <div class="flex flex-col text-center md:text-left w-full">
        <SectionHeader
          size="small"
          as="h2"
          align="left"
          subtitle={role}
          subtitleVariant="badge"
          title={name}
          description={bio}
          paragraphVariant="body"
          paragraphSpacing="xs"
          divider={false}
        />

        <div class="flex flex-wrap items-center justify-center md:justify-between gap-4 mt-3">
          <!-- Primary Social Links -->
          <div data-upwork-hide="true" class="flex items-center gap-2.5">
            {
              primarySocialLinks.map((social) => (
                <SocialLink platform={social.platform} href={social.href} size="sm" />
              ))
            }
          </div>

          <!-- Direct CTA -->
          <div class="flex-shrink-0">
            <PrimaryButton href="/book-a-call" size="lg">
              Book Consultation &rarr;
            </PrimaryButton>
          </div>
        </div>
      </div>
    </div>
  </MedievalFrame>
</div>
