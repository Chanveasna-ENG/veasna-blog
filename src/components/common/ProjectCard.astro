---
import Heading from '../ui/Heading.astro';
import Paragraph from '../ui/Paragraph.astro';
import SecondaryButton from '../ui/SecondaryButton.astro';
import SubtitleTag from '../ui/SubtitleTag.astro';
import MedievalFrame from './MedievalFrame.astro';
import SectionHeader from './SectionHeader.astro';
import {
  type ProjectCardProps,
  resolveProjectCardConfig
} from './project-card.utils';

interface Props extends ProjectCardProps {}

const config = resolveProjectCardConfig(Astro.props);
const { project } = Astro.props;
---

<MedievalFrame size="small" as="article" interactive={true}>
  <div>
    <!-- Project Visual Preview Mockup Box -->
    <div
      class="w-full aspect-[16/10] overflow-hidden border border-ink/40 mb-5 relative bg-parchmentDark/40 pointer-events-none"
    >
      <img
        src={config.imageSrc}
        alt={`${project.title} Architecture Preview`}
        class="w-full h-full object-cover"
        loading="lazy"
      />
      <div class="absolute inset-0 border border-bronze/20 pointer-events-none" />
    </div>

    {
      config.isSlider ? (
        <SectionHeader
          size="small"
          subtitleVariant="ghost"
          subtitle={config.primaryTag}
          title={project.title}
          description={project.description}
          clampTitle={2}
          clampDescription={3}
        />
      ) : (
        <div>
          <div class="flex flex-wrap items-center gap-2 mb-3">
            {project.tags.map((tag) => (
              <SubtitleTag variant="ghost" size="sm" spacing="none">
                #{tag}
              </SubtitleTag>
            ))}
          </div>

          <Heading as="h2" size="card">
            {project.title}
          </Heading>

          <Paragraph variant="small">
            {project.description}
          </Paragraph>
        </div>
      )
    }
  </div>

  <!-- Card Action / Footer Row -->
  <div
    class={`${config.isSlider ? 'pt-4' : 'pt-6'} border-t border-ink/15 flex items-center justify-between mt-auto`}
  >
    <span
      class="font-heading font-semibold text-xs text-bronze uppercase tracking-widest"
    >
      {config.label}
    </span>

    {
      config.isSlider ? (
        <a
          href={config.href}
          class="portfolio-card-link inline-flex items-center justify-center w-9 h-9 border border-ink text-ink bg-parchment/60 group-hover:bg-bronze group-hover:text-parchment group-hover:border-bronze transition-all"
          aria-label={`Read case study: ${project.title}`}
        >
          <span class="text-sm font-bold">&rarr;</span>
        </a>
      ) : (
        <SecondaryButton
          href={config.href}
          className="text-xs !py-2 !px-4"
        >
          Read Architecture &rarr;
        </SecondaryButton>
      )
    }
  </div>
</MedievalFrame>
