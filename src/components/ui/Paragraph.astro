---
import { type ParagraphProps, getParagraphClasses } from './paragraph.utils';

interface Props extends ParagraphProps {
  as?: 'p' | 'span';
}

const {
  variant = 'body',
  color,
  align = 'left',
  clamp = 'none',
  spacing = 'md',
  as = 'p'
} = Astro.props;

const Tag = as;
const classes = getParagraphClasses({ variant, color, align, clamp, spacing });
---

<Tag class={classes}>
  <slot />
</Tag>
