---
interface Props {
  size?: 'sm' | 'md' | 'lg';
  text?: string;
  className?: string;
}

const { size = 'md', text = '', className = '' } = Astro.props;

const dimensions: Record<string, string> = {
  sm: 'w-10 h-10',
  md: 'w-14 h-14',
  lg: 'w-20 h-20'
};

const dimensionClass = dimensions[size] || dimensions.md;
---

<div
  class={`relative inline-flex items-center justify-center select-none ${dimensionClass} ${className}`}
>
  <img
    src="/wax-seal.png"
    alt="Wax Seal Badge"
    class="w-full h-full drop-shadow-md"
  />
</div>
