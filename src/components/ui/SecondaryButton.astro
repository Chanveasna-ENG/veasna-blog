---
import type { HTMLAttributes } from 'astro/types';
import {
  type SecondaryButtonSize,
  resolveSecondaryButtonClasses
} from './secondary-button.utils';

type ButtonAttrs = Omit<HTMLAttributes<'button'>, 'type' | 'size'>;
type AnchorAttrs = Omit<
  HTMLAttributes<'a'>,
  'type' | 'size' | 'href' | 'target'
>;

interface CustomProps {
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  target?: string;
  size?: SecondaryButtonSize;
  active?: boolean;
  className?: string;
}

type Props = CustomProps & ButtonAttrs & AnchorAttrs;

const {
  href,
  type = 'button',
  target = '_self',
  size = 'md',
  active = false,
  className = '',
  ...rest
} = Astro.props;

const { containerClass, innerLineClass } = resolveSecondaryButtonClasses({
  size,
  active,
  className
});
---

{
  href ? (
    <a href={href} target={target} class={containerClass} {...rest}>
      <span class={innerLineClass} />
      <span class="relative z-10">
        <slot />
      </span>
    </a>
  ) : (
    <button type={type} class={containerClass} {...rest}>
      <span class={innerLineClass} />
      <span class="relative z-10">
        <slot />
      </span>
    </button>
  )
}
