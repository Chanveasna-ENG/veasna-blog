---
import {
  type SocialLinkSize,
  type SocialPlatform,
  getSocialIconPath,
  getSocialLabel,
  getSocialLinkDimensions,
  getSocialTarget
} from '../../data/socials';

interface Props {
  platform: SocialPlatform;
  href: string;
  label?: string;
  size?: SocialLinkSize;
  class?: string;
  className?: string;
}

const {
  platform,
  href,
  label,
  size = 'md',
  class: classProp,
  className = ''
} = Astro.props;
const customClass = classProp || className;

const displayLabel = getSocialLabel(platform, label);
const iconSrc = getSocialIconPath(platform);
const { target, rel } = getSocialTarget(platform);
const { boxClass, iconClass, iconDimension } = getSocialLinkDimensions(size);
---

<a
  href={href}
  target={target}
  rel={rel}
  aria-label={displayLabel}
  title={displayLabel}
  class={`inline-flex items-center justify-center ${boxClass} border border-ink text-ink bg-parchment/60 hover:bg-parchmentDark hover:border-bronze transition-all duration-200 shadow-sm hover:shadow-md group ${customClass}`}
>
  <img
    src={iconSrc}
    alt={displayLabel}
    width={iconDimension}
    height={iconDimension}
    class={`${iconClass} object-contain opacity-90 group-hover:opacity-100 group-hover:scale-110 transition-transform`}
    loading="lazy"
  />
</a>
