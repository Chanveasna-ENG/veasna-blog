---
import {
  type SocialPlatform,
  getSocialIconPath,
  getSocialLabel,
  getSocialTarget
} from '../../data/socials';

interface Props {
  platform: SocialPlatform;
  href: string;
  label?: string;
  className?: string;
}

const { platform, href, label, className = '' } = Astro.props;

const displayLabel = getSocialLabel(platform, label);
const iconSrc = getSocialIconPath(platform);
const { target, rel } = getSocialTarget(platform);
---

<a
  href={href}
  target={target}
  rel={rel}
  aria-label={displayLabel}
  title={displayLabel}
  class={`inline-flex items-center justify-center w-11 h-11 border border-ink text-ink bg-parchment/60 hover:bg-parchmentDark hover:border-bronze transition-all duration-200 shadow-sm hover:shadow-md group ${className}`}
>
  <img
    src={iconSrc}
    alt={displayLabel}
    width="20"
    height="20"
    class="w-5 h-5 object-contain opacity-90 group-hover:opacity-100 group-hover:scale-110 transition-transform"
    loading="lazy"
  />
</a>
