---
interface Props {
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  target?: string;
  size?: 'md' | 'lg';
  className?: string;
}

const {
  href,
  type,
  target = '_self',
  size = 'lg',
  className = ''
} = Astro.props;

const paddingClasses =
  size === 'lg'
    ? 'px-8 py-3.5 text-lg md:text-xl'
    : 'px-6 py-2.5 text-base md:text-lg';

const baseClasses = `relative inline-flex items-center justify-center font-heading font-bold uppercase tracking-wider text-parchment bg-ink hover:bg-bronze border-2 border-bronze hover:border-ink transition-all duration-300 group engraved-shadow cursor-pointer ${paddingClasses} ${className}`;
---

{
  href ? (
    <a href={href} target={target} class={baseClasses}>
      <!-- Decorative Inner Line Frame -->
      <span
        class="absolute inset-[3px] border border-bronze opacity-60 group-hover:border-parchment transition-colors pointer-events-none"
      />

      <!-- Left & Right Arrow Accents -->
      <span class="relative z-10 font-bold drop-shadow">
        <slot />
      </span>
    </a>
  ) : (
    <button type={type || 'button'} class={baseClasses}>
      <!-- Decorative Inner Line Frame -->
      <span
        class="absolute inset-[3px] border border-bronze opacity-60 group-hover:border-parchment transition-colors pointer-events-none"
      />

      <!-- Left & Right Arrow Accents -->
      <span class="relative z-10 font-bold drop-shadow">
        <slot />
      </span>
    </button>
  )
}
