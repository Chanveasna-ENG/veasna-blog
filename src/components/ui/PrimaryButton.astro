---
import type { HTMLAttributes } from 'astro/types';
import {
  type PrimaryButtonSize,
  resolvePrimaryButtonClasses
} from './primary-button.utils';

type ButtonAttrs = Omit<
  HTMLAttributes<'button'>,
  'type' | 'size' | 'class' | 'className'
>;
type AnchorAttrs = Omit<
  HTMLAttributes<'a'>,
  'type' | 'size' | 'href' | 'target' | 'class' | 'className'
>;

interface CustomProps {
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  target?: string;
  size?: PrimaryButtonSize;
  fullWidth?: boolean;
  id?: string;
}

type Props = CustomProps & ButtonAttrs & AnchorAttrs;

const {
  href,
  type,
  target = '_self',
  size = 'lg',
  fullWidth = false,
  ...rest
} = Astro.props;

const { containerClass, innerLineClass } = resolvePrimaryButtonClasses({
  size,
  fullWidth
});
---

{
  href ? (
    <a href={href} target={target} class={containerClass} {...rest}>
      <!-- Decorative Inner Line Frame -->
      <span class={innerLineClass} />

      <!-- Content Slot -->
      <span class="relative z-10 font-bold drop-shadow">
        <slot />
      </span>
    </a>
  ) : (
    <button type={type || 'button'} class={containerClass} {...rest}>
      <!-- Decorative Inner Line Frame -->
      <span class={innerLineClass} />

      <!-- Content Slot -->
      <span class="relative z-10 font-bold drop-shadow">
        <slot />
      </span>
    </button>
  )
}
