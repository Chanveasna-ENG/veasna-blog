---
import { type HeadingProps, getHeadingClasses } from './heading.utils';

interface Props extends HeadingProps {}

const {
  as = 'h2',
  size,
  color = 'ink',
  align = 'left',
  spacing = 'md',
  clamp = 'none',
  id
} = Astro.props;

const Tag = as;
const classes = getHeadingClasses({ as, size, color, align, spacing, clamp });
---

<Tag id={id} class={classes}>
  <slot />
</Tag>
