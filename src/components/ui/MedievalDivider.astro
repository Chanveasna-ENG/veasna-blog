---
interface Props {
  variant?: 'diamond' | 'feather' | 'knot' | 'divider-1' | 'simple';
  className?: string;
}

const { variant = 'diamond', className = '' } = Astro.props;

// Strict 2-divider system:
// 'diamond' -> Section boundary divider
// 'feather' -> In-section header/content divider
const isDiamond =
  variant === 'diamond' || variant === 'knot' || variant === 'divider-1';
---

<div class={`w-full flex items-center justify-center my-0 text-ink ${className}`}>
  {isDiamond ? (
    <div class="w-full max-w-5xl flex items-center justify-center px-2">
      <img
        src="/svg/divider-diamond.svg"
        alt="Medieval Diamond Section Divider"
        class="w-full max-w-full object-contain"
        loading="lazy"
      />
    </div>
  ) : (
    <div class="w-full max-w-lg flex items-center justify-center">
      <img
        src="/svg/medieval-divider-feather.svg"
        alt="Medieval Feather Header Divider"
        class="h-6 md:h-8 w-full max-w-[400px] object-contain"
        loading="lazy"
      />
    </div>
  )}
</div>


