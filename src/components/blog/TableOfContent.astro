---
import type { MarkdownHeading } from 'astro';
import Heading from '../ui/Heading.astro';
import { filterTocHeadings, resolveHeadingIndentClass } from './blog-toc.utils';

interface Props {
  headings: MarkdownHeading[];
  variant?: 'mobile' | 'desktop' | 'all';
}

const { headings, variant = 'all' } = Astro.props;
const toc = filterTocHeadings(headings);
const showMobile = variant === 'all' || variant === 'mobile';
const showDesktop = variant === 'all' || variant === 'desktop';
---

{toc.length > 0 && (
  <div class="w-full">
    {/* Mobile Collapsible TOC */}
    {showMobile && (
      <details class="block lg:hidden mb-8 p-4 bg-parchmentDark/40 border border-ink/20 rounded-sm group">
      <summary class="cursor-pointer font-heading font-semibold text-sm uppercase tracking-wider text-ink flex items-center justify-between select-none list-none [&::-webkit-details-marker]:hidden">
        <span class="flex items-center gap-2">
          <span class="text-bronze font-bold">&sect;</span>
          Table of Contents ({toc.length})
        </span>
        <span class="text-xs font-mono text-inkMuted group-open:rotate-180 transition-transform">
          &#9660;
        </span>
      </summary>
      <ul class="flex flex-col space-y-2 mt-4 pt-3 border-t border-ink/10">
        {toc.map((heading) => {
          const indentClass = resolveHeadingIndentClass(heading.depth);
          return (
            <li class={indentClass}>
              <a
                href={`#${heading.slug}`}
                class="toc-link block text-ink/70 hover:text-bronze border-l-2 border-transparent pl-2.5 transition-colors py-0.5"
                data-slug={heading.slug}
              >
                {heading.text}
              </a>
            </li>
          );
        })}
      </ul>
    </details>
    )}

    {/* Desktop Sticky Sidebar TOC */}
    {showDesktop && (
      <nav
        class="hidden lg:block w-full max-h-[calc(100vh-14rem)] flex flex-col p-5 bg-parchmentDark/30 border border-ink/20 rounded-sm overflow-hidden"
        aria-label="Table of Contents"
      >
        <div class="mb-3 flex-shrink-0">
          <Heading as="h2" size="card" color="bronze" spacing="none">
            Table of Contents
          </Heading>
        </div>
        <ul class="flex flex-col space-y-2.5 overflow-y-auto pr-2 pb-6">
          {toc.map((heading) => {
            const indentClass = resolveHeadingIndentClass(heading.depth);
            return (
              <li class={indentClass}>
                <a
                  href={`#${heading.slug}`}
                  class="toc-link block text-ink/70 hover:text-bronze border-l-2 border-transparent pl-2.5 transition-all py-0.5 leading-snug"
                  data-slug={heading.slug}
                >
                  {heading.text}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>
    )}
  </div>
)}

<script>
  import { resolveActiveHeadingId } from './blog-toc.utils';

  function setupTocScrollSpy() {
    const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
    if (tocLinks.length === 0) return;

    const headingElements = Array.from(
      document.querySelectorAll<HTMLElement>(
        'article.blog-article-body h2[id], article.blog-article-body h3[id]'
      )
    );
    if (headingElements.length === 0) return;

    function highlightActiveHeading() {
      const headingRects = headingElements.map((el) => ({
        id: el.id,
        top: el.getBoundingClientRect().top
      }));

      const activeId = resolveActiveHeadingId(headingRects, 140);

      tocLinks.forEach((link) => {
        const slug = link.getAttribute('data-slug');
        if (slug === activeId) {
          link.classList.add('text-bronze', 'font-bold', 'border-bronze');
          link.classList.remove('text-ink/70', 'border-transparent');
        } else {
          link.classList.remove('text-bronze', 'font-bold', 'border-bronze');
          link.classList.add('text-ink/70', 'border-transparent');
        }
      });
    }

    window.addEventListener('scroll', highlightActiveHeading, { passive: true });
    highlightActiveHeading();
  }

  setupTocScrollSpy();
  document.addEventListener('astro:after-swap', setupTocScrollSpy);
</script>