---
import type { CollectionEntry } from 'astro:content';
import { calculateReadingTime, formatReadingTime } from '../../utils/blog';
import { formatDateICT } from '../../utils/date';
import Heading from '../ui/Heading.astro';
import MedievalDivider from '../ui/MedievalDivider.astro';
import SubtitleTag from '../ui/SubtitleTag.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;

// Enforce fallback date logic and precomputed reading time
const targetDate = post.data.lastModifiedAt || post.data.createdAt;
const readingTimeText = formatReadingTime(
  calculateReadingTime(post.body || '')
);
const isProject = post.data.category === 'project';
const breadcrumbHref = isProject ? '/portfolio' : '/page/1';
const breadcrumbText = isProject ? 'Back to Portfolio' : 'Back to Articles';
---

<header class="mb-10 flex flex-col items-start pb-8">
  {/* Back to Archive Breadcrumb */}
  <a
    href={breadcrumbHref}
    class="inline-flex items-center gap-2 text-xs font-heading font-semibold uppercase tracking-widest text-inkMuted hover:text-bronze transition-colors mb-6 group"
  >
    <span class="transition-transform group-hover:-translate-x-1">&larr;</span>
    {breadcrumbText}
  </a>

  {/* Category & Version Badges */}
  <div class="flex items-center gap-3 mb-4">
    <SubtitleTag variant="badge">
      {post.data.category || 'Architecture'}
    </SubtitleTag>
    <span class="inline-flex items-center px-2 py-0.5 rounded-sm text-xs font-mono font-medium border border-ink/20 text-inkMuted bg-parchmentDark/30">
      v{post.data.version}
    </span>
  </div>

  {/* Post Title */}
  <Heading as="h1" size="hero" color="bronze" spacing="lg">
    {post.data.title}
  </Heading>

  {/* Author, Date & Reading Time Meta */}
  <div class="flex flex-wrap items-center text-inkMuted text-sm font-body gap-x-4 gap-y-2">
    <time datetime={targetDate.toISOString()}>
      Last Modified: <span class="text-ink font-medium">{formatDateICT(targetDate)}</span>
    </time>
    <span class="hidden sm:inline text-ink/30" aria-hidden="true">|</span>
    <span>
      By <span class="text-ink font-medium">{post.data.author}</span>
    </span>
    <span class="hidden sm:inline text-ink/30" aria-hidden="true">|</span>
    <span class="text-bronze font-mono text-xs font-semibold">
      {readingTimeText}
    </span>
  </div>

  {/* Tags Array */}
  {post.data.tags && post.data.tags.length > 0 && (
    <div class="flex flex-wrap gap-2 mt-6">
      {post.data.tags.map((tag) => (
        <span class="inline-flex items-center px-2.5 py-1 rounded-sm text-xs font-body border border-ink/20 text-ink/80 bg-parchment hover:border-bronze hover:text-bronze transition-colors">
          #{tag}
        </span>
      ))}
    </div>
  )}

  {/* Type-Specific Metadata */}
  {(post.data.repoUrl || post.data.demoUrl || post.data.eventResult || post.data.eventLocation || post.data.eventDate) && (
    <div class="mt-8 flex flex-col gap-3 p-5 bg-parchmentDark/40 border border-ink/20 rounded-sm w-full font-body text-sm">
      {post.data.repoUrl && (
        <div class="flex items-start gap-3">
          <span class="text-ink font-medium min-w-[110px] mt-0.5">Repository:</span>
          <a href={post.data.repoUrl} target="_blank" rel="noopener noreferrer" class="text-bronze hover:underline break-all">
            {post.data.repoUrl}
          </a>
        </div>
      )}
      {post.data.demoUrl && (
        <div class="flex items-start gap-3">
          <span class="text-ink font-medium min-w-[110px] mt-0.5">Live Demo:</span>
          <a href={post.data.demoUrl} target="_blank" rel="noopener noreferrer" class="text-bronze hover:underline break-all">
            {post.data.demoUrl}
          </a>
        </div>
      )}
      {post.data.eventResult && (
        <div class="flex items-start gap-3">
          <span class="text-ink font-medium min-w-[110px] mt-0.5">Event Result:</span>
          <span class="text-ink font-medium">{post.data.eventResult}</span>
        </div>
      )}
      {post.data.eventLocation && (
        <div class="flex items-start gap-3">
          <span class="text-ink font-medium min-w-[110px] mt-0.5">Location:</span>
          <span class="text-ink/80">{post.data.eventLocation}</span>
        </div>
      )}
      {post.data.eventDate && (
        <div class="flex items-start gap-3">
          <span class="text-ink font-medium min-w-[110px] mt-0.5">Event Date:</span>
          <span class="text-ink/80">{formatDateICT(post.data.eventDate)}</span>
        </div>
      )}
    </div>
  )}

  <MedievalDivider variant="diamond" className="mt-8" />
</header>