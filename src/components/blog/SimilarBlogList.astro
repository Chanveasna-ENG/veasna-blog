---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import MedievalFrame from '../common/MedievalFrame.astro';
import Heading from '../ui/Heading.astro';
import Paragraph from '../ui/Paragraph.astro';
import { resolveBlogCardConfig } from './blog-card.utils';
import { getTopSimilarPosts } from './similar-posts.utils';

interface Props {
  currentPost: CollectionEntry<'blog'>;
}

const { currentPost } = Astro.props;

// Fetch all non-draft posts to calculate recommendations
const allPosts = await getCollection('blog', (post) => !post.data.draft);

const mappedPosts = allPosts.map((p) => ({
  ...p,
  title: p.data.title,
  description: p.data.description,
  category: p.data.category,
  tags: p.data.tags,
  createdAt: p.data.createdAt,
  lastModifiedAt: p.data.lastModifiedAt
}));

const currentMapped = {
  ...currentPost,
  title: currentPost.data.title,
  description: currentPost.data.description,
  category: currentPost.data.category,
  tags: currentPost.data.tags,
  createdAt: currentPost.data.createdAt,
  lastModifiedAt: currentPost.data.lastModifiedAt
};

const similarPosts = getTopSimilarPosts(currentMapped, mappedPosts, 3);
---

{similarPosts.length > 0 && (
  <section class="mt-12 pt-8 border-t border-ink/20" aria-labelledby="similar-posts-heading">
    <div class="flex items-center justify-between mb-6">
      <Heading as="h2" size="card" color="bronze" id="similar-posts-heading" spacing="none">
        Related Analyses
      </Heading>
      <a
        href="/page/1"
        class="text-xs font-heading font-semibold uppercase tracking-widest text-inkMuted hover:text-bronze transition-colors"
      >
        View Archive &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {similarPosts.map((post) => {
        const config = resolveBlogCardConfig({
          id: post.id,
          title: post.data.title,
          description: post.data.description,
          category: post.data.category,
          tags: post.data.tags,
          coverImageSrc: post.data.coverImage?.src,
          coverAlt: post.data.coverAlt,
          createdAt: post.data.createdAt,
          lastModifiedAt: post.data.lastModifiedAt
        });

        return (
          <MedievalFrame size="small" as="article" interactive={true}>
            <a href={config.href} class="flex flex-col h-full group focus:outline-none p-1">
              <div class="w-full aspect-[16/10] overflow-hidden border border-ink/30 relative bg-parchmentDark/40 flex items-center justify-center mb-3">
                <img
                  src={config.imageSrc}
                  alt={post.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              </div>
              <div class="flex flex-col flex-grow">
                <div class="text-[11px] font-mono text-bronze uppercase tracking-widest mb-1.5">
                  {config.categoryLabel} &bull; {config.dateText}
                </div>
                <Heading as="h3" size="sm" color="ink" clamp={2} spacing="xs">
                  {post.data.title}
                </Heading>
                <div class="mt-auto">
                  <Paragraph variant="caption" color="inkMuted" clamp={2} spacing="none">
                    {post.data.description}
                  </Paragraph>
                </div>
              </div>
            </a>
          </MedievalFrame>
        );
      })}
    </div>
  </section>
)}