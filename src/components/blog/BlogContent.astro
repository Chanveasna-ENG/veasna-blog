---
// Renders the markdown body with parchment theme typography tokens and code copy triggers.
// Expects the rendered Astro <Content /> to be passed as children via <slot />.
---

<article 
  class="
    blog-article-body
    prose prose-lg max-w-none w-full
    prose-headings:font-alice prose-headings:text-ink prose-headings:font-bold prose-headings:scroll-mt-24
    prose-p:text-ink prose-p:font-body prose-p:leading-relaxed
    prose-a:text-bronze prose-a:underline hover:prose-a:text-ink transition-colors
    prose-strong:text-ink prose-strong:font-bold
    prose-blockquote:border-l-4 prose-blockquote:border-l-bronze prose-blockquote:bg-parchmentDark/40 prose-blockquote:text-ink prose-blockquote:font-body prose-blockquote:py-2 prose-blockquote:px-5 prose-blockquote:not-italic prose-blockquote:rounded-r-sm
    prose-code:text-bronze prose-code:bg-parchmentDark/70 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-sm prose-code:font-mono prose-code:before:hidden prose-code:after:hidden
    prose-pre:bg-[#1a1714] prose-pre:border prose-pre:border-ink/30 prose-pre:text-[#f4efe6] prose-pre:rounded-sm prose-pre:p-4 prose-pre:relative prose-pre:shadow-sm
    prose-img:border prose-img:border-ink/20 prose-img:rounded-sm
    prose-li:text-ink prose-li:font-body
    prose-hr:border-ink/20
  "
>
  <slot />
</article>

<style is:global>
  article.blog-article-body pre.astro-code {
    background-color: #1a1714 !important;
    border: 1px solid rgba(44, 24, 16, 0.25) !important;
    color: #f4efe6 !important;
  }
</style>

<script>
  function setupCodeCopyButtons() {
    const codeBlocks = document.querySelectorAll<HTMLElement>('article.blog-article-body pre');
    codeBlocks.forEach((pre) => {
      pre.classList.add('bg-[#1a1714]');
      if (pre.querySelector('.copy-code-btn')) return;

      const button = document.createElement('button');
      button.className =
        'copy-code-btn absolute top-2 right-2 px-2 py-1 text-xs font-mono bg-parchmentDark/90 text-ink border border-ink/30 rounded-sm hover:bg-bronze hover:text-white transition-colors cursor-pointer select-none';
      button.type = 'button';
      button.innerText = 'Copy';
      button.setAttribute('aria-label', 'Copy code snippet to clipboard');

      button.addEventListener('click', async () => {
        const code = pre.querySelector('code');
        const text = code ? code.innerText : pre.innerText;
        try {
          await navigator.clipboard.writeText(text);
          button.innerText = 'Copied!';
          setTimeout(() => {
            button.innerText = 'Copy';
          }, 2000);
        } catch {
          button.innerText = 'Failed';
          setTimeout(() => {
            button.innerText = 'Copy';
          }, 2000);
        }
      });

      pre.style.position = 'relative';
      pre.appendChild(button);
    });
  }

  setupCodeCopyButtons();
  document.addEventListener('astro:after-swap', setupCodeCopyButtons);
</script>