---
// Client-side scroll reading progress indicator pinned to top of viewport
---

<div
  id="reading-progress-track"
  class="fixed top-0 left-0 w-full h-1 z-50 bg-transparent pointer-events-none"
  aria-hidden="true"
>
  <div
    id="reading-progress-bar"
    class="h-full bg-bronze w-0 transition-all duration-75 ease-out shadow-[0_0_8px_rgba(184,134,11,0.5)]"
  >
  </div>
</div>

<script>
  function setupReadingProgress() {
    const bar = document.getElementById('reading-progress-bar');
    if (!bar) return;

    let ticking = false;

    function updateProgress() {
      if (!bar) return;
      const docEl = document.documentElement;
      const totalHeight = docEl.scrollHeight - window.innerHeight;
      if (totalHeight <= 0) {
        bar.style.width = '0%';
        ticking = false;
        return;
      }
      const progress = Math.min(100, Math.max(0, (window.scrollY / totalHeight) * 100));
      bar.style.width = `${progress}%`;
      ticking = false;
    }

    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(updateProgress);
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    updateProgress();
  }

  setupReadingProgress();
  document.addEventListener('astro:after-swap', setupReadingProgress);
</script>
