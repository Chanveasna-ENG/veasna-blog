---
import MedievalFrame from '../common/MedievalFrame.astro';
import SectionHeader from '../common/SectionHeader.astro';
import PrimaryButton from '../ui/PrimaryButton.astro';

interface Props {
  imageUrl?: string;
}

const { imageUrl = '/images/profile.jpg' } = Astro.props;
---

<div class="w-full">
  <MedievalFrame size="small" background="parchment">
    <div class="flex flex-col items-center text-center">
      <!-- Sharp Headshot Box (clean border, zero shadow) -->
      <div class="w-20 h-20 overflow-hidden border border-ink relative mb-4 bg-parchmentDark/40 flex-shrink-0">
        <img
          src={imageUrl}
          alt="Chanveasna Eng"
          class="w-full h-full object-cover"
          loading="lazy"
        />
      </div>

      <SectionHeader
        size="small"
        align="center"
        title="Start Your Project"
        description="Start your project with a free discovery call and see how we can bring your vision to life."
        divider={false}
      />

      <div class="mt-3 w-full">
        <PrimaryButton href="/book-a-call" size="md" fullWidth>
          Hire Us &rarr;
        </PrimaryButton>
      </div>
    </div>
  </MedievalFrame>
</div>
