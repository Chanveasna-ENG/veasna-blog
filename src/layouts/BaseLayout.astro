---
import '../styles/global.css';
import FloatingBookingWidget from '../components/common/FloatingBookingWidget.astro';
import MetaHead from '../components/common/MetaHead.astro';
import FooterSection from '../components/sections/FooterSection.astro';
import HeaderNav from '../components/sections/HeaderNav.astro';
import { getUpworkUrl } from '../data/socials';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image } = Astro.props;

const pathname = Astro.url.pathname.replace(/\/$/, '');
const isBookingPage = pathname === '/book-a-call';
const upworkUrl = getUpworkUrl();
---

<!doctype html>
<html lang="en">
  <head>
    <MetaHead title={title} description={description} image={image} />
    <script is:inline define:vars={{ upworkUrl }}>
      (function () {
        try {
          var key = 'upwork_mode_expiry';
          var ttl = 24 * 60 * 60 * 1000;
          var now = Date.now();
          var searchParams = new URLSearchParams(window.location.search);
          var hasParam = searchParams.get('upwork') === 'true';
          var stored = localStorage.getItem(key);
          var storedExpiry = stored ? parseInt(stored, 10) : null;
          var isActive = false;

          if (hasParam) {
            isActive = true;
            localStorage.setItem(key, String(now + ttl));
          } else if (storedExpiry && storedExpiry > now) {
            isActive = true;
          } else if (storedExpiry) {
            localStorage.removeItem(key);
          }

          if (isActive) {
            document.documentElement.setAttribute('data-upwork-mode', 'true');
            var path = window.location.pathname.replace(/\/$/, '');
            if (path === '/contact' || path === '/book-a-call') {
              window.location.replace(upworkUrl);
            }
          }
        } catch (e) {}
      })();
    </script>
    <script src="../scripts/upwork-mode-client.ts"></script>
  </head>
  <body class="min-h-screen flex flex-col text-ink antialiased">
    <HeaderNav currentPath={Astro.url.pathname} />

    <main class="flex-grow w-full">
      <slot />
    </main>

    {!isBookingPage && <FloatingBookingWidget />}

    <FooterSection />
  </body>
</html>